{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "author": {
      "default": "Barry",
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "domains": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "web",
          "cloud",
          "embedded"
        ]
      }
    },
    "read": {
      "type": "string"
    },
    "tags": {
      "type": "string"
    },
    "icon": {
      "default": "BookOpen",
      "type": "string",
      "enum": [
        "Activity",
        "Bug",
        "Server",
        "BookOpen",
        "Palette",
        "Terminal"
      ]
    },
    "cover": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "alt": {
          "type": "string"
        }
      },
      "required": [
        "url",
        "alt"
      ]
    },
    "body": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "alt": {
          "type": "string"
        }
      },
      "required": [
        "url",
        "alt"
      ]
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "date"
  ]
}