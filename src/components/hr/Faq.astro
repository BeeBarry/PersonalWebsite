---
// FAQ — en spalt, grupperad efter var i rekryteringen frågan dyker upp.
//
// Tidigare låg frågorna i ett tvåspaltigt grid. Det fungerar inte för
// ett dragspel: när en post fälls ut växer bara den ena spalten, och grannen
// lämnar ett par hundra pixlar hål. `align-items:start` gjorde hålet synligt i
// stället för att sträcka grannen — men båda utfallen är fel. En spalt läser
// dessutom som det FAQ är: en fråga i taget.
//
// Grupperingen ersätter den kategorietikett som förut stod på var och en av
// raderna. Samma information, en gång per grupp i stället för på varje fråga.
// Ordningen i faqCategories är HR:s väg genom en rekrytering, med "Teknik i
// praktiken" som en snabb uppslagspunkt när ett begrepp behöver redas ut.
//
// EN gemensam [data-hr-accordion] runt alla grupper (inte en per grupp) —
// annars kan fyra frågor stå öppna samtidigt. hrGuide.ts letar heads med
// querySelectorAll, så nästlingen spelar ingen roll.
//
// Varje svar länkar till de kort frågan taggats med (samma tags-array som
// driver kortens "Vanliga frågor om X").
import Icon from "../site/Icon.astro";
import { hrFaq, hrFaqCategories, cardById, typo } from "../../data/hr";

// Tomma kategorier utelämnas, så en ny kategori i JSON:en inte kan rita en
// rubrik utan frågor under.
const groups = hrFaqCategories
  .map((cat) => ({ cat, items: hrFaq.filter((f) => f.cat === cat) }))
  .filter((g) => g.items.length > 0);
const totalRows = groups.reduce((total, group) => total + group.items.length, 0);
---

<div data-hr-faq>
  <div class="hr-chips hr-faq__chips" role="group" aria-label="Visa frågor för" data-hr-faq-filters>
    <button class="hr-chip is-active" type="button" data-hr-faq-filter="Alla" aria-pressed="true">
      Alla
    </button>
    {
      groups.map((group) => (
        <button class="hr-chip" type="button" data-hr-faq-filter={group.cat} aria-pressed="false">
          {group.cat}
        </button>
      ))
    }
  </div>
  <p class="hr-count" data-hr-faq-count aria-live="polite" aria-atomic="true" hidden>
    {totalRows} av {totalRows} frågor visas
  </p>

  <div class="hr-faq" data-hr-accordion>
    {
      groups.map((g) => (
        <section class="hr-faq__group" data-hr-faq-group={g.cat}>
          <h3 class="hr-faq__grouptitle">
            <span>{g.cat}</span>
            <span class="hr-faq__groupcount">{g.items.length}</span>
          </h3>

          <div class="hr-acc">
            {g.items.map((item) => {
              // flatMap i stället för filter med typpredikat: `(c): c is …` går
              // inte att parsa i Astros mall-uttryck (astro check ts(1005)),
              // och flatMap ger samma smala typ utan predikat.
              const tagCards = item.tags.flatMap((t) => {
                const c = cardById(t);
                return c ? [c] : [];
              });
              const open = item.id === "f1";
              return (
                <div class="hr-acc__item" data-hr-faq-item>
                  <button
                    type="button"
                    class="hr-acc__head"
                    data-hr-acc-head
                    aria-expanded={open ? "true" : "false"}
                  >
                    <span class="hr-faq__q">{typo(item.q)}</span>
                    <span class="hr-acc__sign" aria-hidden="true">
                      {open ? "−" : "+"}
                    </span>
                  </button>

                  <div class="hr-acc__body" data-hr-acc-body hidden={!open}>
                    <p class="hr-faq__a">{typo(item.a)}</p>
                    {tagCards.length > 0 && (
                      <>
                        <p class="hr-faq__cardlabel">Läs kortet</p>
                        <div class="hr-faq__links">
                          {tagCards.map((c) => (
                            <a class="hr-faq__link" href={`/for-hr/${c.id}/`}>
                              {c.title}
                              <Icon name="ArrowRight" size={12} />
                            </a>
                          ))}
                        </div>
                      </>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        </section>
      ))
    }
  </div>

  <p class="hr-faq__note">
    Har du en fråga som inte står här? Den blir troligen nästa post — skicka den.
  </p>
</div>
