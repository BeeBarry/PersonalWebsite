---
// FAQ — alla frågor i ett dragspel, en öppen i taget (f1 öppen från start).
// Medvetet utan kategorifilter: med elva frågor kostade filtret mer än det gav
// (tre av elva syntes vid ankomst). Kategorin står i stället som monoetikett
// per rad. Varje svar länkar till de kort frågan taggats med (samma tags-array
// som driver kortens "Vanliga frågor om X"). hrGuide.ts sköter togglingen.
import Icon from "../site/Icon.astro";
import { hrFaq, cardById, typo } from "../../data/hr";
---

<div data-hr-faq>
  {/* --cols delar upp frågorna i två spalter från 1000px. Modifieraren behövs
      för att Annonsen använder samma .hr-acc men har en tvåkolumns-layout
      INUTI varje rad — den ska förbli en spalt. */}
  <div class="hr-acc hr-acc--cols" data-hr-accordion>
    {
      hrFaq.map((item) => {
        // flatMap i stället för filter med typpredikat: `(c): c is …` går inte
        // att parsa i Astros mall-uttryck (astro check ts(1005)), och flatMap
        // ger samma smala typ utan predikat.
        const tagCards = item.tags.flatMap((t) => {
          const c = cardById(t);
          return c ? [c] : [];
        });
        const open = item.id === "f1";
        return (
          <div class="hr-acc__item" data-hr-faqitem data-hr-cat={item.cat}>
            <button
              type="button"
              class="hr-acc__head"
              data-hr-acc-head
              aria-expanded={open ? "true" : "false"}
            >
              <span class="hr-faq__q">
                <span class="hr-faq__cat">{item.cat}</span>
                {typo(item.q)}
              </span>
              <span class="hr-acc__sign" aria-hidden="true">{open ? "−" : "+"}</span>
            </button>
            <div class="hr-acc__body" data-hr-acc-body hidden={!open}>
              <p class="hr-faq__a">{typo(item.a)}</p>
              {tagCards.length > 0 && (
                <>
                  <p class="hr-faq__cardlabel">Läs kortet</p>
                  <div class="hr-faq__links">
                    {tagCards.map((c) => (
                      <a class="hr-faq__link" href={`/for-hr/${c.id}/`}>
                        {c.title}
                        <Icon name="ArrowRight" size={12} />
                      </a>
                    ))}
                  </div>
                </>
              )}
            </div>
          </div>
        );
      })
    }
  </div>

  <p class="hr-faq__note">
    Har du en fråga som inte står här? Den blir troligen nästa post — skicka den.
  </p>
</div>
