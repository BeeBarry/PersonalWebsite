---
// Annonsen — annons-översättaren. Dragspel, en rad öppen i taget (rad 0 öppen
// från start); hrGuide.ts sköter toggling.
//
// EN spalt. Tidigare stod citatet och betydelsen sida vid sida i ett grid som
// tre element måste hålla synkat — kolumnrubrikerna, radens huvud och radens
// utfällda kropp — plus en fjärde regel för pilen i rännan och en femte för
// +/− som egen kolumn. Det var mycket maskineri för att säga "det här betyder
// det här", och den utfällda raden lämnade en tom halva till vänster.
//
// Staplat gör samma sak utan maskineriet: citatet i mono med citattecken,
// betydelsen i brödtext direkt under. Den typografiska kontrasten bär
// relationen — samma grepp som en ordlista använder mellan term och
// definition. Inget grid, inga kolumnrubriker, ingen tom halva.
import Icon from "../site/Icon.astro";
import { hrTranslate, cardById, typo } from "../../data/hr";
---

<div data-hr-translate>
  <div class="hr-acc" data-hr-accordion>
    {
      hrTranslate.map((row, i) => {
        const card = row.card ? cardById(row.card) : undefined;
        return (
          <div class="hr-acc__item">
            <button
              type="button"
              class="hr-acc__head"
              data-hr-acc-head
              aria-expanded={i === 0 ? "true" : "false"}
            >
              <span class="hr-tr__said">
                <span class="hr-tr__say">”{typo(row.say)}”</span>
                <span class="hr-tr__means">{typo(row.means)}</span>
              </span>
              <span class="hr-acc__sign" aria-hidden="true">{i === 0 ? "−" : "+"}</span>
            </button>

            <div class="hr-acc__body" data-hr-acc-body hidden={i !== 0}>
              {/* Två sorters råd, samma uppbyggnad — bara etiketten och
                  vänsterkanten skiljer dem åt. */}
              <div class="hr-tr__block">
                <p class="hr-tr__blocklabel">Leta efter</p>
                <p class="hr-tr__blocktext">{typo(row.look)}</p>
              </div>

              <div class="hr-tr__block hr-tr__block--watch">
                <p class="hr-tr__blocklabel">
                  <Icon name="AlertTriangle" size={12} />
                  Fallgropen
                </p>
                <p class="hr-tr__blocktext">{typo(row.watch)}</p>
              </div>

              {card && (
                <a class="hr-tr__cardlink" href={`/for-hr/${card.id}/`}>
                  Öppna kortet {card.title}
                  <Icon name="ArrowRight" size={13} />
                </a>
              )}
            </div>
          </div>
        );
      })
    }
  </div>
</div>
