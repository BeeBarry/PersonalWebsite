---
// components/ZoomableImage.astro
interface Props {
    src: string;
    alt: string;
    caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<div class="image-container">
    <img src={src} alt={alt} class="zoomable-image" loading="lazy" />
    {caption && <p class="image-caption">{caption}</p>}
</div>

<style>
    .image-container {
        margin: 2rem 0;
        text-align: center;
    }

    .zoomable-image {
        max-width: 100%;
        border-radius: 8px;
        cursor: zoom-in;
    }

    /* Ny klass för att dölja originalbilden */
    .zoomable-image.hidden {
        opacity: 0;
    }

    @media (max-width: 600px) {
        .zoomable-image {
            cursor: default;
        }
    }

    .image-caption {
        font-size: 0.9rem;
        color: #666;
        margin-top: 0.5rem;
        font-style: italic;
    }

    .zoomed-clone {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        max-width: 80%;
        max-height: 80vh;
        z-index: 1000;
        cursor: zoom-out;
        object-fit: contain;
        border-radius: 8px;
        box-shadow: 0 0 20px 5px rgba(0, 0, 0, 0.5);
    }

    :global(.zoom-overlay) {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.82);
        backdrop-filter: blur(4px);
        z-index: 999;
        display: none;
    }

    :global(.zoom-overlay.active) {
        display: block;
    }

    :global(.zoomed-clone) {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        max-width: 90%;
        max-height: 90vh;
        z-index: 1000;
        cursor: zoom-out;
        object-fit: contain;
        border-radius: 10px;
        box-shadow: 0 20px 60px -10px rgba(0, 0, 0, 0.8);
    }
</style>

<script>
    // ZoomableImage via event-delegation.
    //
    // BUGFIX (zoom overlay kvar efter close): ClientRouter byter ut <body>-innehåll
    // vid View Transitions, vilket även tar bort den overlay-div vi appendat. Den
    // gamla varianten cachade en referens till overlay i closure och gjorde
    // `overlay.classList.remove('active')` mot ett detached element → ingen visuell
    // effekt, overlay stannar synlig från en tidigare öppning. Fixen:
    //   1. Bind document-handlers EN gång (document persisterar genom VT).
    //   2. Säkerställ att overlay-elementet finns i DOM vid varje astro:page-load.
    //   3. Stäng-logiken slår upp overlay LIVE varje gång via querySelector,
    //      inte från closure.

    let listenersAttached = false;
    let isClosing = false;

    function ensureOverlay(): HTMLDivElement {
        let el = document.querySelector<HTMLDivElement>('.zoom-overlay');
        if (!el) {
            el = document.createElement('div');
            el.className = 'zoom-overlay';
            document.body.appendChild(el);
        }
        return el;
    }

    function closeZoom() {
        if (isClosing) return;
        isClosing = true;
        const clone = document.querySelector('.zoomed-clone');
        const hidden = document.querySelector('.zoomable-image.hidden');
        const overlay = document.querySelector('.zoom-overlay');
        if (hidden) hidden.classList.remove('hidden');
        if (clone) clone.remove();
        if (overlay) overlay.classList.remove('active');
        // Återställ scroll-lås ENBART om ingen sheet är öppen (sheet-drawer
        // sätter sin egen overflow:hidden — vi får inte skriva över den).
        if (!document.querySelector('.sheet.open')) {
            document.body.style.overflow = '';
        }
        // Mikro-frist innan vi släpper guarden, så en ev. event-duplicate inte
        // re-triggar close direkt.
        requestAnimationFrame(() => { isClosing = false; });
    }

    function openZoom(img: HTMLImageElement) {
        if (document.querySelector('.zoomed-clone')) return;
        const overlay = ensureOverlay();
        img.classList.add('hidden');
        const clone = img.cloneNode(true) as HTMLImageElement;
        clone.classList.add('zoomed-clone');
        clone.classList.remove('zoomable-image', 'hidden');
        document.body.appendChild(clone);
        overlay.classList.add('active');
        document.body.style.overflow = 'hidden';
    }

    function bindZoom() {
        // Garantera att overlay finns i nuvarande DOM (återskapas efter VT-swap).
        ensureOverlay();

        if (listenersAttached) return;
        listenersAttached = true;

        const isMobile = () => window.innerWidth <= 600;

        document.addEventListener('click', (e) => {
            if (isMobile()) return;
            const target = e.target as Element;

            // Klick på en zoombar bild → öppna
            const img = target.closest('.zoomable-image') as HTMLImageElement | null;
            if (img && !document.querySelector('.zoomed-clone')) {
                e.stopPropagation();
                openZoom(img);
                return;
            }

            // Klick någon annanstans när en clone är öppen → stäng
            if (document.querySelector('.zoomed-clone')) {
                if (
                    target.classList.contains('zoomed-clone') ||
                    target.classList.contains('zoom-overlay') ||
                    !target.closest('.zoomed-clone')
                ) {
                    closeZoom();
                }
            }
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && document.querySelector('.zoomed-clone')) {
                closeZoom();
            }
        });
    }

    bindZoom();
    document.addEventListener('astro:page-load', bindZoom);
    // Innan VT-swappen tar bort overlay: stäng aktiv zoom rent.
    document.addEventListener('astro:before-swap', () => {
        if (document.querySelector('.zoomed-clone')) closeZoom();
    });
</script>