---
// Varumärke i sidebar: textmärke "barry" + accent-dot (portfolio-lettermark),
// samt kort roll-beskrivning (döljs på mobil där sidebar är komprimerad).
import site from "../../config/site";
---

{/* Ingen bottenmarginal på mobil: märket delar rad med ikonerna, och
    avståndet ned till navigationen sätts av den i stället. */}
<div class="lg:mb-8">
  <a
    href="/"
    class="inline-flex items-baseline gap-1"
    aria-label={`Hem — ${site.meta.title}`}
  >
    <span class="text-xl font-extrabold tracking-tight text-foreground"
      >{site.brand.name}</span
    >
    <span class="h-1.5 w-1.5 rounded-full bg-primary"></span>
  </a>
  <p class="mt-2.5 hidden text-[11.5px] leading-[1.5] tracking-wide text-muted-foreground/70 lg:block">
    {site.brand.tagline}
  </p>
</div>
