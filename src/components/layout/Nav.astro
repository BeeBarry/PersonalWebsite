---
// Vänster-navigation (Breeze-port). Datadriven via site.navigation.
// devOnly-poster (t.ex. Learn Hub) döljs i prod men syns i `astro dev`.
// Aktiv rutt highlightas; pil glider in vid hover.
import site from "../../config/site";
import { Icon } from "astro-icon/components";

const currentPath = Astro.url.pathname;
const items = site.navigation.filter(
  (item) => !item.devOnly || import.meta.env.DEV,
);
---

<nav
  class="no-scrollbar flex flex-wrap gap-2 overflow-x-auto max-md:justify-between md:flex-1 md:flex-col md:gap-2 md:overflow-x-visible"
>
  {
    items.map((item) => {
      const isActive =
        currentPath === item.href ||
        (item.href !== "/" && currentPath.startsWith(item.href));
      return (
        <a
          href={item.href}
          aria-current={isActive ? "page" : undefined}
          class:list={[
            "group flex min-w-24 items-center justify-center rounded-2xl border border-transparent px-4 py-3 transition-all md:min-w-0 md:justify-between md:py-3.5",
            isActive
              ? "border-primary/20 bg-primary/10 md:hover:bg-primary/15"
              : "hover:bg-muted/50",
          ]}
        >
          <div class="flex flex-col">
            <span
              class:list={[
                "text-sm font-bold",
                isActive
                  ? "text-primary"
                  : "text-muted-foreground group-hover:text-primary",
              ]}
            >
              {item.name}
            </span>
            <span
              class:list={[
                "text-[10px] tracking-widest uppercase",
                isActive ? "text-primary/60" : "text-muted-foreground/50",
              ]}
            >
              {item.subtitle}
            </span>
          </div>

          <span
            class:list={[
              "hidden text-primary transition-all md:block",
              isActive
                ? ""
                : "-translate-x-2 opacity-0 group-hover:translate-x-0 group-hover:opacity-100",
            ]}
          >
            <Icon name="mdi:arrow-right" />
          </span>
        </a>
      );
    })
  }
</nav>
