---
// Vänster-navigation (Breeze-port). Datadriven via site.navigation.
// devOnly-poster (t.ex. Learn Hub) döljs i prod men syns i `astro dev`.
// Aktiv rutt highlightas; pil glider in vid hover.
import site from "../../config/site";
import { Icon } from "astro-icon/components";

const currentPath = Astro.url.pathname;
const items = site.navigation.filter(
  (item) => !item.devOnly || import.meta.env.DEV,
);
---

{/* Under lg: ett rutnät om tre kolumner, INTE en scrollande rad. Fem poster
    blir 3 + 2 och syns allihop utan att någon behöver dras i sidled.

    En enda rad går inte att få till: 375 px ger 343 px innanför padding, och
    ”Fältnoteringar” ensam mäter ~84 px vid 11 px halvfet. Fem poster hade
    behövt 64 px var. Att korta ned etiketterna hade lösts på bekostnad av att
    de säger vad de säger — två rader kostar 40 px och behåller orden. */}
<nav
  class="mt-2.5 grid grid-cols-3 gap-1.5 lg:mt-0 lg:flex lg:flex-1 lg:flex-col lg:gap-2"
>
  {
    items.map((item) => {
      const isActive =
        currentPath === item.href ||
        (item.href !== "/" && currentPath.startsWith(item.href));
      return (
        <a
          href={item.href}
          aria-current={isActive ? "page" : undefined}
          class:list={[
            // Under lg: en cell i rutnätet. Kompakt padding och centrerad
            // text så de längsta etiketterna ryms i en tredjedels bredd.
            "group flex min-w-0 items-center justify-center rounded-lg border border-transparent px-1.5 py-1.5 text-center transition-all lg:rounded-xl lg:px-3 lg:py-2.5 lg:justify-between lg:text-left",
            isActive
              ? "border-primary/20 bg-primary/10 lg:hover:bg-primary/15"
              : "hover:bg-muted/50",
          ]}
        >
          <div class="flex min-w-0 flex-col max-lg:w-full">
            <span
              class:list={[
                "truncate text-[11px] font-bold leading-tight lg:text-[13px]",
                isActive
                  ? "text-primary"
                  : "text-muted-foreground group-hover:text-primary",
              ]}
            >
              {item.name}
            </span>
            <span
              class:list={[
                "text-[9px] tracking-[0.16em] uppercase max-lg:hidden",
                isActive ? "text-primary/60" : "text-muted-foreground/50",
              ]}
            >
              {item.subtitle}
            </span>
          </div>

          <span
            class:list={[
              "hidden text-primary transition-all lg:block",
              isActive
                ? ""
                : "-translate-x-2 opacity-0 group-hover:translate-x-0 group-hover:opacity-100",
            ]}
          >
            <Icon name="mdi:arrow-right" />
          </span>
        </a>
      );
    })
  }
</nav>
