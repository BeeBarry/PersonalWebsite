---
// Vänster-navigation (Breeze-port). Datadriven via site.navigation.
// devOnly-poster (t.ex. Learn Hub) döljs i prod men syns i `astro dev`.
// Aktiv rutt highlightas; pil glider in vid hover.
import site from "../../config/site";
import { Icon } from "astro-icon/components";

const currentPath = Astro.url.pathname;
const items = site.navigation.filter(
  (item) => !item.devOnly || import.meta.env.DEV,
);
---

<nav
  class="no-scrollbar flex gap-2 overflow-x-auto lg:flex-1 lg:flex-col lg:gap-2 lg:overflow-x-visible"
>
  {
    items.map((item) => {
      const isActive =
        currentPath === item.href ||
        (item.href !== "/" && currentPath.startsWith(item.href));
      return (
        <a
          href={item.href}
          aria-current={isActive ? "page" : undefined}
          class:list={[
            // Under lg: en scrollbar rad (shrink-0 så posterna behåller sin
            // bredd i stället för att wrappa till en ojämn 3+1-layout).
            "group flex min-w-0 items-center justify-center rounded-xl border border-transparent px-4 py-3 transition-all max-lg:shrink-0 lg:px-3 lg:py-2.5 lg:justify-between",
            isActive
              ? "border-primary/20 bg-primary/10 lg:hover:bg-primary/15"
              : "hover:bg-muted/50",
          ]}
        >
          <div class="flex flex-col">
            <span
              class:list={[
                "text-[13px] font-bold leading-tight",
                isActive
                  ? "text-primary"
                  : "text-muted-foreground group-hover:text-primary",
              ]}
            >
              {item.name}
            </span>
            <span
              class:list={[
                "text-[9px] tracking-[0.16em] uppercase max-lg:hidden",
                isActive ? "text-primary/60" : "text-muted-foreground/50",
              ]}
            >
              {item.subtitle}
            </span>
          </div>

          <span
            class:list={[
              "hidden text-primary transition-all lg:block",
              isActive
                ? ""
                : "-translate-x-2 opacity-0 group-hover:translate-x-0 group-hover:opacity-100",
            ]}
          >
            <Icon name="mdi:arrow-right" />
          </span>
        </a>
      );
    })
  }
</nav>
