---
interface Props {
    href: string;
    title: string;
    description?: string;
    date: string;
    read?: string;
    showRead?: boolean;
    domains?: string;
    sheetKey?: string;
}
const { href, title, description, date, read, showRead = false, domains, sheetKey } = Astro.props;
---
<a class="pf-post" href={href} data-domains={domains} data-sheet-open={sheetKey}>
    <div class="pf-t">{title}</div>
    {description && <div class="pf-d">{description}</div>}
    <span class="pf-date">{showRead && read ? `${date} · ${read}` : date}</span>
</a>
