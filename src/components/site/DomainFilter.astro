---
/*
 * DomainFilter — chip-rad för att filtrera kort på domän (/works, /posts).
 * Återanvänder .filterbar/.tag-stilarna. "Alla" är default-aktiv. Kräver JS;
 * utan JS döljs raden (alla kort visas ändå). Logik: src/scripts/domainFilter.ts.
 */
interface FilterOption { label: string; value: string; count: number; }
interface Props { filters: FilterOption[]; }
const { filters } = Astro.props;
---
<div class="filterbar" role="group" aria-label="Filtrera på domän" data-domain-filterbar>
    {filters.map((f, i) => (
        <button
            type="button"
            class={`tag${i === 0 ? ' is-active' : ''}`}
            data-filter={f.value}
            aria-pressed={i === 0 ? 'true' : 'false'}
        >
            {f.label}<span class="tag__count">{f.count}</span>
        </button>
    ))}
</div>
<noscript>
    <style>[data-domain-filterbar] { display: none; }</style>
</noscript>
