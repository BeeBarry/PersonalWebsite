---
// Inline-SVG ikoner från lucide.dev/icons. Inga npm-deps.
// Användning: <Icon name="ArrowRight" size={16} />
interface Props {
    name: string;
    size?: number;
    class?: string;
    "aria-hidden"?: boolean | string;
}
const { name, size = 18, class: className = "", ...rest } = Astro.props;
const common = {
    width: size,
    height: size,
    viewBox: "0 0 24 24",
    fill: "none",
    stroke: "currentColor",
    "stroke-width": 2,
    "stroke-linecap": "round",
    "stroke-linejoin": "round",
    "aria-hidden": rest["aria-hidden"] ?? "true",
    class: className,
};
