---
import Icon from './Icon.astro';
import ZoomableImage from '../ZoomableImage.astro';

interface ImageRef { url: string; alt: string }

interface Props {
    id: string;
    title: string;
    kind: string;
    year: string;
    description: string;
    meta?: string;
    body?: string[];
    media?: string[];
    images?: ImageRef[];
    logo?: string;
    website?: string;
    github?: string;
}
const {
    id, title, kind, year, description, meta,
    body, media, images, logo, website, github,
} = Astro.props;

// Slot fylls med renderad markdown-Content från works.astro.
const hasSlot = Astro.slots.has('default');
const hasImages = images && images.length > 0;
const liveSite = website && website !== 'TBA' ? website : null;
const ghLink = github && github !== 'TBA' ? github : null;
---
<aside class="sheet" data-sheet-id={id} aria-hidden="true" aria-labelledby={`sheet-h-${id}`}>
    <div class="sheet-pad">
        <div class="grab"></div>
        <div class="sheet-x">
            <button class="iconbtn" type="button" data-close-sheet aria-label="Stäng">
                <Icon name="X" size={18} />
            </button>
        </div>

        <div class="sheet-head">
            {logo && <img class="logo lg" src={logo} alt="" />}
            <div>
                <h3 id={`sheet-h-${id}`}>{title}</h3>
                <div class="skind">{kind}{year ? ` · ${year}` : ''}</div>
            </div>
        </div>

        {/* Renderad markdown-body (om slot finns) */}
        {hasSlot && (
            <div class="pf-body sheet-prose">
                <slot />
            </div>
        )}

        {/* Body från frontmatter (om markdown-content saknas) */}
        {!hasSlot && body && body.length > 0 && (
            <div class="pf-body">
                {body.map((para) => <p>{para}</p>)}
            </div>
        )}

        {/* Fallback om varken slot eller body finns */}
        {!hasSlot && (!body || body.length === 0) && (
            <>
                <div class="pf-body"><p>{description}</p></div>
                <p class="note">Genomgången för det här spåret är på väg — kika in snart.</p>
            </>
        )}

        {/* Faktiska projektbilder, zoombara */}
        {hasImages && (
            <div class="sheet-images">
                {images!.map((img) => (
                    <ZoomableImage src={img.url} alt={img.alt} />
                ))}
            </div>
        )}

        {/* Caption-baserade media-frames (designens placeholder för spår utan riktiga bilder) */}
        {!hasImages && media && media.length > 0 && (
            <div class="media">
                {media.map((cap) => (
                    <div class="frame"><span class="cap">{cap}</span></div>
                ))}
            </div>
        )}

        {meta && <div class="tagrow">{meta}</div>}

        {(ghLink || liveSite) && (
            <div class="slinks">
                {ghLink && (
                    <a class="slink" href={ghLink} target="_blank" rel="noopener">
                        GitHub <Icon name="ArrowUpRight" size={15} />
                    </a>
                )}
                {liveSite && (
                    <a class="slink" href={liveSite} target="_blank" rel="noopener">
                        Live <Icon name="ArrowUpRight" size={15} />
                    </a>
                )}
            </div>
        )}
    </div>
</aside>

<style>
    /* Bildgrid inuti sheet — tight, klickbara via ZoomableImage */
    .sheet-images {
        display: grid;
        grid-template-columns: 1fr;
        gap: 10px;
        margin-top: 22px;
    }
    .sheet-images :global(.image-container) {
        margin: 0;
    }
    .sheet-images :global(.zoomable-image) {
        width: 100%;
        border-radius: 10px;
        box-shadow: inset 0 0 0 1px var(--c-border);
        background: var(--c-surface);
        display: block;
    }

    /* Markdown-prose inuti sheet — något kompaktare än /projects/[slug] */
    .sheet-prose :global(p) {
        font-size: 1rem;
        line-height: 1.62;
        color: var(--c-text);
        margin: 0;
    }
    .sheet-prose :global(p + p) {
        margin-top: 0.9em;
    }
    .sheet-prose :global(strong) {
        color: var(--c-text);
        font-weight: 700;
    }
    .sheet-prose :global(a) {
        color: var(--c-text);
        text-decoration: underline;
        text-decoration-color: var(--c-accent);
        text-underline-offset: 3px;
    }
    .sheet-prose :global(ul),
    .sheet-prose :global(ol) {
        padding-left: 1.2em;
        margin: 0.6em 0;
    }
    .sheet-prose :global(li) {
        line-height: 1.55;
        margin-bottom: 0.2em;
    }
</style>
