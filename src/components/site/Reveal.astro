---
interface Props {
    delay?: number;
    class?: string;
    id?: string;
}
const { delay = 0, class: className = "", id } = Astro.props;
const styleAttr = delay > 0 ? `transition-delay: ${delay}ms` : undefined;
---
<div
    class={`reveal ${className}`.trim()}
    id={id}
    style={styleAttr}
    data-reveal
>
    <slot />
</div>

<script>
    // IntersectionObserver-baserad reveal. Re-attachas vid astro:page-load
    // så View Transitions inte stör.
    function bindReveal() {
        const els = document.querySelectorAll<HTMLElement>('[data-reveal]:not([data-reveal-bound])');
        if (!els.length) return;
        const io = new IntersectionObserver(
            (entries) => {
                for (const e of entries) {
                    if (e.isIntersecting) {
                        (e.target as HTMLElement).classList.add('in');
                        io.unobserve(e.target);
                    }
                }
            },
            { threshold: 0.1, rootMargin: '0px 0px -6% 0px' }
        );
        els.forEach((el) => {
            el.setAttribute('data-reveal-bound', '1');
            io.observe(el);
        });
    }
    bindReveal();
    document.addEventListener('astro:page-load', bindReveal);
</script>
