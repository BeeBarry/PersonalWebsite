---
// Projektkort för Arbete (2-kolumns grid). Bild + titel + live-markör +
// beskrivning + stack-meta. data-tags gör kortet filtrerbart (type + domän).
interface Props {
  href: string;
  title: string;
  description?: string;
  stack?: string;
  image?: { url: string; alt: string };
  live?: boolean;
  /** Space-separerade taggar (type + domän) för filtrering. */
  tags?: string;
}

const { href, title, description, stack, image, live, tags } = Astro.props;
---

<a
  href={href}
  data-tags={tags}
  class="group flex flex-col overflow-hidden rounded-xl border border-border bg-muted/10 transition-all hover:border-primary/40 hover:bg-muted/20"
>
  {
    image && (
      <div class="aspect-[16/9] overflow-hidden bg-muted/30">
        <img
          src={image.url}
          alt={image.alt}
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
      </div>
    )
  }
  <div class="flex flex-1 flex-col p-3.5">
    <div class="flex items-center gap-2">
      {/* mb-0 nollar h3:ns basmarginal (8px) från @layer base — den lade sig
          ovanpå beskrivningens mt och gav ett gap som inte gick att styra. */}
      <h3
        class="mb-0 text-[13.5px] font-bold text-foreground/90 transition-colors group-hover:text-primary"
      >
        {title}
      </h3>
      {
        live && (
          <span class="text-[9px] font-bold tracking-wide text-primary uppercase">
            live
          </span>
        )
      }
    </div>
    {
      description && (
        <p class="mt-1.5 mb-0 line-clamp-2 text-[12.5px] leading-relaxed text-muted-foreground">
          {description}
        </p>
      )
    }
    {
      stack && (
        <p class="mt-auto mb-0 pt-2.5 font-mono text-[9.5px] tracking-wide text-muted-foreground/60">
          {stack}
        </p>
      )
    }
  </div>
</a>
