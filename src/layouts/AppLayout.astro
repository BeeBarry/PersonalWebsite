---
// App-layout (Breeze-arkitektur): ett inramat kort med persistent Sidebar till
// vänster och en scrollande <main> till höger. Klick i nav byter innehållet i
// main (via View Transitions) — sidebaren står kvar. På mobil staplas de.
import BaseLayout from "./BaseLayout.astro";
import Sidebar from "../components/layout/Sidebar.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: "website" | "article";
}

const props = Astro.props;
---

<BaseLayout {...props}>
  <div
    class="relative z-[2] flex w-full max-w-[86rem] flex-col overflow-visible rounded-none border border-border bg-card shadow-main lg:h-[min(90vh,54rem)] lg:flex-row lg:overflow-hidden lg:rounded-[2.5rem]"
  >
    <a href="#innehall" class="skip-link">Hoppa till innehållet</a>

    <Sidebar />

    <main
      id="innehall"
      tabindex="-1"
      class="custom-scrollbar flex-1 lg:overflow-x-hidden lg:overflow-y-auto"
    >
      <slot />
    </main>
  </div>
</BaseLayout>
