---
import BaseLayout from "./Layout.astro";
const { frontmatter } = Astro.props;
---

<BaseLayout pageTitle={frontmatter.title}>
    <article class="post">
        <header class="post__header">
            <h1 class="post__title">{frontmatter.title}</h1>
            <div class="post__meta">
                <span class="post__meta-item">
                    <span class="badge badge--item">AUTHOR</span>
                    <span class="post__meta-value">{frontmatter.author}</span>
                </span>
                <span class="post__meta-item">
                    <span class="badge badge--item">PUBLISHED</span>
                    <span class="post__meta-value">{frontmatter.date}</span>
                </span>
            </div>
            <hr class="post__divider" />
        </header>
        <div class="post__body">
            <slot />
        </div>
    </article>
</BaseLayout>
