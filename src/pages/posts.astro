---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { showEntry, parsePostDate } from '../utils/content';
import PostItem from '../components/site/PostItem.astro';
import DomainFilter from '../components/site/DomainFilter.astro';
import Reveal from '../components/site/Reveal.astro';
import { domains } from '../data/domains';

const pageTitle = 'Skrivet · Barry Namdari';

const allPosts = (await getCollection('posts', showEntry))
    .sort((a, b) => parsePostDate(b.data.date) - parsePostDate(a.data.date));
const totalCount = allPosts.length;

// Filterchips: "Alla" först (default), sedan domäner som faktiskt har inlägg, med antal.
const has = (slug: string) => allPosts.filter((p) => (p.data.domains ?? []).includes(slug as any)).length;
const filters = [
    { label: 'Alla', value: 'all', count: totalCount },
    ...domains.filter((d) => has(d.slug) > 0).map((d) => ({ label: d.title, value: d.slug, count: has(d.slug) })),
];
---
<Layout pageTitle={pageTitle} containerType="wide">
    <div class="page">
        <Reveal class="intro">
            <div>
                <h1 class="pagetitle">Skrivet</h1>
                <p class="pagesub">
                    Fältnoteringar och tekniska djupdyk — oftast om sånt som gick sönder,
                    varför, och vad jag lärde mig på vägen.
                </p>
                <span class="pagestat">
                    <span class="sq"></span>
                    {totalCount} inlägg
                </span>
            </div>
        </Reveal>

        <Reveal delay={80}>
            <div>
                {totalCount > 0 ? (
                    <>
                        <DomainFilter filters={filters} />
                        <div class="pf-list" data-filter-target>
                            {allPosts.map((p) => (
                                <PostItem
                                    href={`/posts/${p.id}/`}
                                    title={p.data.title}
                                    description={p.data.description}
                                    date={p.data.date}
                                    read={p.data.read}
                                    showRead={true}
                                    domains={(p.data.domains ?? []).join(' ')}
                                />
                            ))}
                        </div>
                        <p class="filter-empty" data-filter-empty hidden>Inga inlägg inom denna domän ännu.</p>
                    </>
                ) : (
                    <p class="pagesub">Inlägg är på väg — kika tillbaka snart.</p>
                )}
            </div>
        </Reveal>
    </div>

    <script>
        import { initDomainFilter } from '../scripts/domainFilter';
        initDomainFilter();
    </script>
</Layout>
