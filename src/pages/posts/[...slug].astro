---
import { getCollection, render } from "astro:content";
import AppLayout from "../../layouts/AppLayout.astro";
import ArticleToc from "../../components/site/ArticleToc.astro";
import Icon from "../../components/site/Icon.astro";
import StickyBar from "../../components/site/StickyBar.astro";
import { showEntry } from "../../utils/content";
import { TOC_MIN_ITEMS } from "../../scripts/toc";

export const prerender = true;
export async function getStaticPaths() {
  const postEntries = await getCollection("posts", showEntry);
  return postEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// Bara h2. Inlägg som lagrar brödtexten i frontmatterns `body` har ingen
// markdown-text och därmed inga rubriker — då blir listan tom och komponenten
// renderar ingenting.
const toc = headings
  .filter((h) => h.depth === 2)
  .map((h) => ({ id: h.slug, label: h.text }));
const showToc = toc.length >= TOC_MIN_ITEMS;

const pageTitle = `${entry.data.title} · Fältnoteringar`;
const metaLine = [entry.data.date, entry.data.read, entry.data.tags]
  .filter(Boolean)
  .join(" · ");

// Delningsbild: inläggets egen bild om den finns, annars sajtens standard-OG.
const ogImage = entry.data.image?.url ?? entry.data.cover?.url;
---

<AppLayout
  title={pageTitle}
  description={entry.data.description}
  image={ogImage}
  ogType="article"
>
  <StickyBar backHref="/posts/" backLabel="Alla noteringar" title={entry.data.title} />

  <div class="site reader">
    <div class:list={["toc-doc", showToc && "toc-doc--toc"]}>
      <article class="article animate-in">
        <a class="backlink" href="/posts/">
          <Icon name="ArrowLeft" size={14} />
          tillbaka
        </a>

        {
          entry.data.cover && (
            <div class="cover">
              <img src={entry.data.cover.url} alt={entry.data.cover.alt} />
            </div>
          )
        }
        <h1 class="amh1">{entry.data.title}</h1>
        <div class="ammeta">{metaLine}</div>
        <ArticleToc items={toc} variant="jump" />
        <div data-sticky-anchor aria-hidden="true"></div>

        <div class="prose">
          <Content />
        </div>
      </article>

      <ArticleToc items={toc} variant="panel" title="I det här inlägget" />
    </div>
  </div>

  <script>
    import { initStickyBar } from "../../scripts/stickyBar";
    import { initToc } from "../../scripts/toc";
    initStickyBar();
    initToc();
  </script>
</AppLayout>
