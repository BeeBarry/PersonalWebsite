---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/site/Icon.astro';
import Reveal from '../../components/site/Reveal.astro';
import ZoomableImage from '../../components/ZoomableImage.astro';
import { showEntry } from '../../utils/content';

export const prerender = true;
export async function getStaticPaths() {
    const projectEntries = await getCollection('projects', showEntry);
    return projectEntries.map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const pageTitle = `${entry.data.title} · Arbete`;
const metaLine = [entry.data.kind, entry.data.year].filter(Boolean).join(' · ');

const images = [
    entry.data.worksImage1,
    entry.data.worksImage2,
    entry.data.worksImage3,
    entry.data.worksImage4,
].filter(Boolean) as Array<{ url: string; alt: string }>;
---
<Layout pageTitle={pageTitle} containerType="wide">
    <main class="article">
        <a class="backlink" href="/works/">
            <Icon name="ArrowLeft" size={14} />
            tillbaka
        </a>
        <Reveal>
            {entry.data.cover && (
                <div class="cover">
                    <img src={entry.data.cover.url} alt={entry.data.cover.alt} />
                </div>
            )}
            <h1 class="amh1">{entry.data.title}</h1>
            <div class="ammeta">{metaLine}{entry.data.stack ? ` · ${entry.data.stack}` : ''}</div>
        </Reveal>

        <Reveal delay={80}>
            <div class="prose">
                {entry.data.body && entry.data.body.length > 0 ? (
                    entry.data.body.map((p) => <p>{p}</p>)
                ) : (
                    <Content />
                )}
            </div>
        </Reveal>

        {(entry.data.github || entry.data.website) && (
            <div class="slinks">
                {entry.data.github && entry.data.github !== 'TBA' && (
                    <a class="slink" href={entry.data.github} target="_blank" rel="noopener">
                        GitHub <Icon name="ArrowUpRight" size={15} />
                    </a>
                )}
                {entry.data.website && entry.data.website !== 'TBA' && (
                    <a class="slink" href={entry.data.website} target="_blank" rel="noopener">
                        Live <Icon name="ArrowUpRight" size={15} />
                    </a>
                )}
            </div>
        )}

        {images.length > 0 && (
            <Reveal delay={120}>
                <div class="project-images">
                    {images.map((img) => (
                        <ZoomableImage src={img.url} alt={img.alt} />
                    ))}
                </div>
            </Reveal>
        )}
    </main>

    <style>
        .project-images {
            display: grid;
            grid-template-columns: 1fr;
            gap: 18px;
            margin-top: clamp(28px, 4vw, 40px);
        }
        /* Desktop: bryt ut bredare än textmåttet, centrerat mot viewporten,
           fluid kolumnantal så udda antal inte ger en strandad tom cell. */
        @media (min-width: 720px) {
            .project-images {
                width: min(960px, calc(100vw - 2 * clamp(22px, 5vw, 60px)));
                margin-left: 50%;
                transform: translateX(-50%);
                grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
                gap: clamp(18px, 2vw, 24px);
            }
        }
        /* Tightare än ZoomableImages default 2rem; vi har redan gap i griden */
        .project-images :global(.image-container) {
            margin: 0;
        }
        /* Fast bildförhållande jämnar ojämna höjder; cover beskär utan distorsion. */
        .project-images :global(.zoomable-image) {
            width: 100%;
            aspect-ratio: 16 / 10;
            object-fit: cover;
            border-radius: 14px;
            box-shadow: inset 0 0 0 1px var(--c-border);
            background: var(--c-surface);
            display: block;
        }
    </style>
</Layout>
