---
import AppLayout from "../../layouts/AppLayout.astro";
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import { categories, CATEGORY_GROUPS } from "../../data/categories";
import { showEntry } from "../../utils/content";

const allArticles = await getCollection("learn", showEntry);
// Kategorier utan publicerade artiklar listas inte — [category]/index.astro
// genererar ingen sida för dem, så ett kort hade blivit en död länk.
const withCounts = categories
  .filter((c) => c.isVisible)
  .map((c) => ({
    ...c,
    count: allArticles.filter((a) => a.data.category === c.slug).length,
  }))
  .filter((c) => c.count > 0);

// Grupperna ersätter det gamla domänfiltret. Tre domäner kunde inte organisera
// nitton kategorier — chipet "Cloud 14" delade korten i 14/3/1/1 och utförde
// alltså inget arbete. Grupperna är i stället rubriker, samma grepp som
// <Del /> gör inuti en artikel: de beskriver strukturen i stället för att
// gömma den bakom ett filter. Ordningen kommer från CATEGORY_GROUPS.
const groups = CATEGORY_GROUPS.map((g) => ({
  ...g,
  items: withCounts.filter((c) => c.group === g.slug),
})).filter((g) => g.items.length > 0);
---

<AppLayout
  title="Learn Hub · Barry Namdari"
  description="Områden jag lär mig om och förklarar enkelt."
>
  <div class="animate-in p-6 lg:p-8">
    <header class="mb-8">
      {/* Etiketten är ett <p>, inte en rubrik: den står ovanför h1 och skulle
          annars ligga som syskon till gruppernas h2 i dokumentets disposition. */}
      <p
        class="mb-2 font-mono text-[10px] tracking-[0.22em] text-muted-foreground/50 uppercase"
      >
        Learn Hub
      </p>
      <h1 class="text-xl font-bold tracking-tight text-foreground">
        Områden jag lär mig
      </h1>
      <p class="mt-2 max-w-prose text-[13.5px] leading-relaxed text-muted-foreground">
        Ämnen jag lär mig om och försöker förklara på ett lättbegripligt sätt.
        Ordningen går nedifrån och upp — fundamenten först, det som vilar på dem
        sedan.
      </p>
    </header>

    <div class="flex flex-col gap-8">
      {
        groups.map((g) => (
          <section>
            <h2 class="mb-0 text-[13px] font-bold tracking-tight text-foreground">
              {g.title}
            </h2>
            <p class="mt-1 mb-3 max-w-prose text-[11.5px] leading-snug text-muted-foreground/80">
              {g.description}
            </p>
            <div class="grid grid-cols-2 gap-2 sm:gap-2.5 sm:grid-cols-[repeat(auto-fill,minmax(15.5rem,1fr))]">
              {g.items.map((c) => (
                <a
                  href={`/learn-hub/${c.slug}/`}
                  class="group flex items-start gap-2.5 rounded-xl border border-border bg-muted/10 p-2.5 sm:gap-3 sm:p-3 transition-all hover:border-primary/40 hover:bg-muted/20"
                >
                  {/* items-start, inte items-center: ikonen hör ihop med rubriken och
                      ska ligga i linje med den, inte flyta mitt emot ett tre rader
                      högt textblock. */}
                  <Icon name={c.icon} class="h-6 w-auto shrink-0 sm:h-7" />
                  <div class="min-w-0 flex-1">
                    {/* mb-0 på BÅDA: h3 ärver 8px och p 16px bottenmarginal från
                        @layer base, och de nollades aldrig här. Tillsammans 24px som
                        inte gjorde något. Uppmätt: kortet gick från 104 till 80px. */}
                    {/* MOBIL: rubrik och räknare staplade. Sida vid sida i ett
                        halvbrett kort rann räknaren ut ur kortet och lade sig över
                        rubriken — halva radbredden räcker inte för båda. */}
                    <div class="flex flex-col gap-0.5 sm:flex-row sm:items-start sm:justify-between sm:gap-2">
                      <h3 class="mb-0 text-[13.5px] leading-snug font-bold text-foreground/90 transition-colors group-hover:text-primary">
                        {c.title}
                      </h3>
                      <span class="shrink-0 font-mono text-[9px] whitespace-nowrap text-muted-foreground/60 sm:pt-px">
                        {c.count} {c.count === 1 ? "artikel" : "artiklar"}
                      </span>
                    </div>
                    {/* line-clamp i stället för truncate: med tre kolumner kapades
                        nästan varje beskrivning mitt i ett ord. */}
                    <p class="mt-1.5 mb-0 line-clamp-2 text-[11.5px] leading-snug text-muted-foreground">
                      {c.description}
                    </p>
                  </div>
                </a>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</AppLayout>
