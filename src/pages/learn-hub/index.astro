---
import AppLayout from "../../layouts/AppLayout.astro";
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import { categories } from "../../data/categories";
import { domains } from "../../data/domains";
import { showEntry } from "../../utils/content";
import DomainChips from "../../components/site/DomainChips.astro";
import StickyBar from "../../components/site/StickyBar.astro";

const allArticles = await getCollection("learn", showEntry);
// Kategorier utan publicerade artiklar listas inte — [category]/index.astro
// genererar ingen sida för dem, så ett kort hade blivit en död länk.
const withCounts = categories
  .filter((c) => c.isVisible)
  .map((c) => ({
    ...c,
    count: allArticles.filter((a) => a.data.category === c.slug).length,
  }))
  .filter((c) => c.count > 0);

const has = (slug: string) => withCounts.filter((c) => c.domain === slug).length;
const filters = [
  { label: "Alla", value: "all", count: withCounts.length },
  ...domains
    .filter((d) => has(d.slug) > 0)
    .map((d) => ({ label: d.short, value: d.slug, count: has(d.slug) })),
];
// Med bara en domän kvar blir chipsraden "Alla / Cloud" — ett filter utan val.
// Visa den först när det finns minst två domäner att växla mellan.
const showFilters = filters.length > 2;
---

<AppLayout
  title="Learn Hub · Barry Namdari"
  description="Områden jag lär mig om och förklarar enkelt."
>
  {
    showFilters && (
      <StickyBar title="Learn Hub">
        <DomainChips filters={filters} compact />
      </StickyBar>
    )
  }

  <div class="animate-in p-6 lg:p-8">
    <header class="mb-6">
      <h2
        class="mb-2 font-mono text-[10px] tracking-[0.22em] text-muted-foreground/50 uppercase"
      >
        Learn Hub
      </h2>
      <h1 class="text-xl font-bold tracking-tight text-foreground">
        Områden jag lär mig
      </h1>
      <p class="mt-2 max-w-prose text-[13.5px] leading-relaxed text-muted-foreground">
        Ämnen jag lär mig om och försöker förklara på ett lättbegripligt sätt.
      </p>
    </header>

    {showFilters && <DomainChips filters={filters} />}

    <div data-sticky-anchor aria-hidden="true"></div>
    <div
      class="grid gap-2.5 grid-cols-[repeat(auto-fill,minmax(min(100%,15.5rem),1fr))]"
      data-filter-target
    >
      {
        withCounts.map((c) => (
          <a
            href={`/learn-hub/${c.slug}/`}
            data-tags={c.domain}
            class="group flex items-start gap-3 rounded-xl border border-border bg-muted/10 p-3 transition-all hover:border-primary/40 hover:bg-muted/20"
          >
            {/* items-start, inte items-center: ikonen hör ihop med rubriken och
                ska ligga i linje med den, inte flyta mitt emot ett tre rader
                högt textblock. */}
            <Icon name={c.icon} class="h-7 w-7 shrink-0" />
            <div class="min-w-0 flex-1">
              {/* Räknaren flyttad hit uppe till höger. Som egen rad i botten
                  kostade den ~16px höjd på varje kort medan ytan bredvid
                  rubriken stod tom — nu bär samma rad båda och kortet blir
                  lägre. */}
              {/* mb-0 på BÅDA: h3 ärver 8px och p 16px bottenmarginal från
                  @layer base, och de nollades aldrig här. Tillsammans 24px som
                  inte gjorde något — de 16 på sista stycket låg som ren dödyta
                  i kortets underkant. Uppmätt: kortet gick från 104 till 80px.
                  Gapet mellan rubrik och text bärs nu av mt-1.5 allena. */}
              <div class="flex items-start justify-between gap-2">
                <h3 class="mb-0 text-[13.5px] leading-snug font-bold text-foreground/90 transition-colors group-hover:text-primary">
                  {c.title}
                </h3>
                <span class="shrink-0 pt-px font-mono text-[9px] whitespace-nowrap text-muted-foreground/60">
                  {c.count} {c.count === 1 ? "artikel" : "artiklar"}
                </span>
              </div>
              {/* line-clamp i stället för truncate: med tre kolumner kapades
                  nästan varje beskrivning mitt i ett ord. */}
              <p class="mt-1.5 mb-0 line-clamp-2 text-[11.5px] leading-snug text-muted-foreground">
                {c.description}
              </p>
            </div>
          </a>
        ))
      }
    </div>

    <p class="mt-6 text-sm text-muted-foreground" data-filter-empty hidden>
      Inga områden i denna domän ännu.
    </p>
  </div>

  <script>
    import { initDomainFilter } from "../../scripts/domainFilter";
    import { initStickyBar } from "../../scripts/stickyBar";
    initDomainFilter();
    initStickyBar();
  </script>
</AppLayout>
