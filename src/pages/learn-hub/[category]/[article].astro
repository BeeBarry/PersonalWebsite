---
import { getCollection, render } from "astro:content";
import AppLayout from "../../../layouts/AppLayout.astro";
import { categories } from "../../../data/categories";
import ZoomableImage from "../../../components/ZoomableImage.astro";
import Icon from "../../../components/site/Icon.astro";
import StickyBar from "../../../components/site/StickyBar.astro";
import { showEntry } from "../../../utils/content";

export async function getStaticPaths() {
  const all = await getCollection("learn", showEntry);
  return all.map((entry) => ({
    params: { category: entry.data.category, article: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const cat = categories.find((c) => c.slug === entry.data.category);
---

<AppLayout
  title={`${entry.data.title} · Learn Hub`}
  description={entry.data.description}
>
  <StickyBar
    backHref={`/learn-hub/${entry.data.category}/`}
    backLabel={cat?.title ?? "Learn Hub"}
    title={entry.data.title}
  />

  <div class="site reader">
    <main class="article animate-in">
      <a class="backlink" href={`/learn-hub/${entry.data.category}/`}>
        <Icon name="ArrowLeft" size={14} />
        {cat?.title ?? "Learn Hub"}
      </a>

      <h1 class="amh1">{entry.data.title}</h1>
      <div class="ammeta">{entry.data.description}</div>
      <div data-sticky-anchor aria-hidden="true"></div>

      <div class="prose">
        <Content components={{ ZoomableImage }} />
      </div>
    </main>
  </div>

  <script>
    import { initStickyBar } from "../../../scripts/stickyBar";
    initStickyBar();
  </script>
</AppLayout>
