---
import { getCollection, render } from "astro:content";
import AppLayout from "../../../layouts/AppLayout.astro";
import { categories } from "../../../data/categories";
import ZoomableImage from "../../../components/ZoomableImage.astro";
import ArticleToc from "../../../components/site/ArticleToc.astro";
import Icon from "../../../components/site/Icon.astro";
import StickyBar from "../../../components/site/StickyBar.astro";
import SeriesNav from "../../../components/site/SeriesNav.astro";
import { showLearnEntry } from "../../../utils/content";
import { TOC_MIN_ITEMS } from "../../../scripts/toc";

// Lärkitet — pedagogiska komponenter som artiklarna använder utan att behöva
// importera dem själva (se components-propen på <Content /> längre ner).
import Flow from "../../../components/learn/Flow.astro";
import Stack from "../../../components/learn/Stack.astro";
import Split from "../../../components/learn/Split.astro";
import Callout from "../../../components/learn/Callout.astro";
import Check from "../../../components/learn/Check.astro";
import Del from "../../../components/learn/Del.astro";
import Doodle from "../../../components/learn/Doodle.astro";
import "../../../styles/learn.css";

export async function getStaticPaths() {
  const all = await getCollection("learn", showLearnEntry);
  return all.map((entry) => ({
    params: { category: entry.data.category, article: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const cat = categories.find((c) => c.slug === entry.data.category);

// Sektionsblocken kommer från <Del titel="…" /> i MDX-källan: varje Del hör
// till h2-rubriken som följer närmast efter den. Källan är alltså brödtexten,
// inte frontmatter — annars finns samma uppgift på två ställen och de glider
// isär så fort någon flyttar en rubrik.
//
// Matchningen sker på ORDNING, inte på rubriktext: en rubrik som
// `## \`git add\` vs \`git commit\`` har backticks i källan men inte i
// headings[].text, och en textjämförelse hade tyst missat just de rubrikerna.
// Räknaren stegas bara av rader som börjar med "## " — kontrollerat att inget
// kodblock i hubben innehåller en sådan rad.
const groupAt = new Map<number, string>();
{
  const marker = /^(?:<Del\s+titel="([^"]+)"\s*\/>|## )/gm;
  let index = 0;
  let pending: string | null = null;
  for (const m of (entry.body ?? "").matchAll(marker)) {
    if (m[1] !== undefined) {
      pending = m[1];
      continue;
    }
    if (pending !== null) {
      groupAt.set(index, pending);
      pending = null;
    }
    index += 1;
  }
}

// Bara h2 — h3 och nedåt gör förteckningen längre än den är användbar.
// Astro sätter redan id på rubrikerna, så slug:en duger som ankare.
const toc = headings
  .filter((h) => h.depth === 2)
  .map((h, i) => ({ id: h.slug, label: h.text, group: groupAt.get(i) }));
const showToc = toc.length >= TOC_MIN_ITEMS;
---

<AppLayout
  title={`${entry.data.title} · Learn Hub`}
  description={entry.data.description}
  image={entry.data.image?.url}
  ogType="article"
>
  <StickyBar
    backHref={`/learn-hub/${entry.data.category}/`}
    backLabel={cat?.title ?? "Learn Hub"}
    title={entry.data.title}
  />

  <div class="site reader">
    <div class:list={["toc-doc", showToc && "toc-doc--toc"]}>
      <article class="article animate-in">
        <a class="backlink" href={`/learn-hub/${entry.data.category}/`}>
          <Icon name="ArrowLeft" size={14} />
          {cat?.title ?? "Learn Hub"}
        </a>

        <h1 class="amh1">{entry.data.title}</h1>
        <div class="ammeta">{entry.data.description}</div>
        <ArticleToc items={toc} variant="jump" />
        <div data-sticky-anchor aria-hidden="true"></div>

        {/* Kitet skickas in via components-propen i stället för att varje MDX-fil
            importerar det själv: författandet ska handla om innehåll, inte om
            import-rader, och komponenterna kan bytas ut på ett ställe. */}
        <div class="prose">
          <Content
            components={{ ZoomableImage, Flow, Stack, Split, Callout, Check, Del, Doodle }}
          />
        </div>

        <SeriesNav entry={entry} />
      </article>

      <ArticleToc items={toc} variant="panel" title="I den här artikeln" />
    </div>
  </div>

  <script>
    import { initStickyBar } from "../../../scripts/stickyBar";
    import { initToc } from "../../../scripts/toc";
    initStickyBar();
    initToc();
  </script>
</AppLayout>
