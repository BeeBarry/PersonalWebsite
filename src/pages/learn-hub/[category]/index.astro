---
import { getCollection } from "astro:content";
import AppLayout from "../../../layouts/AppLayout.astro";
import { categories } from "../../../data/categories";
import { showEntry } from "../../../utils/content";
import ContentRow from "../../../components/site/ContentRow.astro";
import { Icon } from "astro-icon/components";

export async function getStaticPaths() {
  return categories.map(({ slug, title }) => ({
    params: { category: slug },
    props: { categoryTitle: title },
  }));
}

const { category } = Astro.params;
const { categoryTitle } = Astro.props;

const articles = (
  await getCollection(
    "learn",
    (e) => e.data.category === category && showEntry(e),
  )
).sort((a, b) => a.data.order - b.data.order);
---

<AppLayout
  title={`${categoryTitle} · Learn Hub`}
  description={`Artiklar om ${categoryTitle}.`}
>
  <div class="animate-in mx-auto max-w-2xl p-6 md:p-10">
    <a
      href="/learn-hub/"
      class="group inline-flex items-center gap-1.5 font-mono text-[12px] tracking-wide text-muted-foreground transition-colors hover:text-primary"
    >
      <Icon
        name="mdi:arrow-left"
        class="transition-transform group-hover:-translate-x-0.5"
      /> Learn Hub
    </a>

    <header class="mt-5 mb-6">
      <h2
        class="mb-2 font-mono text-[10px] tracking-[0.22em] text-muted-foreground/50 uppercase"
      >
        Learn Hub
      </h2>
      <h1 class="text-xl font-bold tracking-tight text-foreground">
        {categoryTitle}
      </h1>
    </header>

    {
      articles.length > 0 ? (
        <div>
          {articles.map((a) => (
            <ContentRow
              href={`/learn-hub/${category}/${a.id}/`}
              title={a.data.title}
              description={a.data.description}
            />
          ))}
        </div>
      ) : (
        <p class="text-muted-foreground">Inga artiklar här ännu.</p>
      )
    }
  </div>
</AppLayout>
