---
import { getCollection } from "astro:content";
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import { showEntry } from '../utils/content';
const allProjects = await getCollection("projects", showEntry);
const pageTitle = "Projekt";
---
<Layout pageTitle={pageTitle} containerType="default">

    <h2>Titta vad man skapat!</h2>

    <ul role="list" class="link-card-grid">
        {allProjects.map((card) => <Card
            url={`/projects/${card.id}/`}
            image={card.data.image.url}
            title={card.data.title}
            body={card.data.description}
        />)}
    </ul>
</Layout>

