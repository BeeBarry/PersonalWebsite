---
import AppLayout from "../layouts/AppLayout.astro";
import { getCollection } from "astro:content";
import { showEntry } from "../utils/content";
import ProjectCard from "../components/site/ProjectCard.astro";
import DomainChips from "../components/site/DomainChips.astro";
import StickyBar from "../components/site/StickyBar.astro";

const allProjects = await getCollection("projects", showEntry);
const totalCount = allProjects.length;

// Filter på type: portfolio = Live · produktion (deployad), lab = Hobby.
const countType = (t: string) =>
  allProjects.filter((p) => p.data.type === t).length;
const filters = [
  { label: "Alla", value: "all", count: totalCount },
  { label: "Live · produktion", value: "portfolio", count: countType("portfolio") },
  { label: "Hobby", value: "lab", count: countType("lab") },
].filter((f) => f.value === "all" || f.count > 0);

const isLive = (p: (typeof allProjects)[number]) =>
  !!p.data.website && p.data.website !== "TBA";
---

<AppLayout
  title="Arbete · Barry Namdari"
  description="Projekt jag byggt — från idé till deploy."
>
  {
    filters.length > 1 && (
      <StickyBar title="Arbete">
        <DomainChips filters={filters} compact />
      </StickyBar>
    )
  }

  <div class="animate-in p-6 lg:px-10 lg:py-12">
    <header class="mb-6">
      <h2
        class="mb-2 font-mono text-[10px] tracking-[0.22em] text-muted-foreground/50 uppercase"
      >
        Arbete
      </h2>
      <h1 class="text-xl font-bold tracking-tight text-foreground">
        Projekt &amp; byggen
      </h1>
      <p class="mt-2 max-w-prose text-[13.5px] leading-relaxed text-muted-foreground">
        Saker jag byggt — från idé till deploy. Klicka för djupare läsning.
      </p>
    </header>

    {filters.length > 1 && <DomainChips filters={filters} />}

    <div data-sticky-anchor aria-hidden="true"></div>
{/* Taket (24rem) är poängen: med 1fr sträcktes två kort till 460px — samma
          bredd som före komprimeringen. Nu ligger de på 384px, mellan de smala
          302px och de gamla 460. Ett tredje projekt fyller raden. */}
    <div class="grid gap-3.5 grid-cols-[repeat(auto-fill,minmax(min(100%,20rem),24rem))]" data-filter-target>
      {
        allProjects.map((p) => (
          <ProjectCard
            href={`/projects/${p.id}/`}
            title={p.data.title}
            description={p.data.description}
            stack={p.data.stack}
            image={p.data.worksImage1 ?? p.data.image}
            live={isLive(p)}
            tags={[p.data.type, ...(p.data.domains ?? [])].join(" ")}
          />
        ))
      }
    </div>

    <p class="mt-6 text-sm text-muted-foreground" data-filter-empty hidden>
      Inga projekt av den typen ännu.
    </p>
  </div>

  <script>
    import { initDomainFilter } from "../scripts/domainFilter";
    import { initStickyBar } from "../scripts/stickyBar";
    initDomainFilter();
    initStickyBar();
  </script>
</AppLayout>
