---
import AppLayout from "../layouts/AppLayout.astro";
import Icon from "../components/site/Icon.astro";
---

<AppLayout title="404 · Barry Namdari" description="Sidan finns inte.">
  <div class="site reader">
    <main class="article animate-in">
      <div class="cover" style="display:grid;place-items:center;">
        <Icon name="BookOpen" size={42} />
      </div>
      <h1 class="amh1">404</h1>
      <div class="ammeta">sidan finns inte — eller den har flyttat</div>

      <div class="prose">
        <p>
          Det här innehållet ligger inte längre här. Det är troligen vägen som
          har förändrats, inte du.
        </p>
        <a class="slink" href="/" style="margin-top: 1.5rem;">
          Tillbaka hem <Icon name="ArrowRight" size={15} />
        </a>
      </div>
    </main>
  </div>
</AppLayout>
