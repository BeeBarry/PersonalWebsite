---
import Layout from '../layouts/Layout.astro';
const pageTitle = "Designsystem";

const colors = [
  { name: "--c-bg", role: "Bakgrund (papper)", var: "var(--c-bg)" },
  { name: "--c-surface", role: "Yta / kort", var: "var(--c-surface)" },
  { name: "--c-text", role: "Text", var: "var(--c-text)" },
  { name: "--c-text-muted", role: "Sekundär text", var: "var(--c-text-muted)" },
  { name: "--c-accent", role: "Accent", var: "var(--c-accent)" },
  { name: "--c-border", role: "Kantlinje", var: "var(--c-border)" },
];

const type = [
  { tag: "h1", label: "Rubrik 1 — clamp(2.2–3rem)" },
  { tag: "h2", label: "Rubrik 2 — clamp(1.6–2.1rem)" },
  { tag: "h3", label: "Rubrik 3 — 1.3rem" },
];
---
<Layout pageTitle={pageTitle} containerType="wide">
  <h1>Designsystem</h1>
  <p>
    Levande referens för tokens och komponentmönster. Detta är ytan vi
    itererar designet på. Växla tema med sol/måne-ikonen i navbaren.
  </p>

  <section class="ds-section">
    <h2>Färg</h2>
    <div class="ds-grid">
      {colors.map((c) => (
        <div class="ds-swatch">
          <div class="ds-swatch__chip" style={`background:${c.var}`}></div>
          <div class="ds-swatch__meta">
            <strong>{c.role}</strong>
            <code>{c.name}</code>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="ds-section">
    <h2>Typografi — Schibsted Grotesk + Spline Sans Mono</h2>
    {type.map((t) => {
      const Tag = t.tag;
      return <Tag>{t.label}</Tag>;
    })}
    <p>
      Brödtext i Schibsted Grotesk via Astro 6 Fonts API. Mono-detaljer
      (meta, kicker, dates) i Spline Sans Mono. Länkar ser <a href="#">ut så här</a>.
    </p>
    <p><small>Meta / small — 0.875rem, dämpad färg.</small></p>
  </section>

  <section class="ds-section">
    <h2>Knappar</h2>
    <div class="ds-row">
      <button class="btn">Primär knapp</button>
      <button class="btn btn--ghost">Sekundär (ghost)</button>
    </div>
  </section>

  <section class="ds-section">
    <h2>Taggar &amp; chips</h2>
    <div class="ds-row">
      <span class="badge">Badge</span>
      <button class="tag" type="button">Filter</button>
      <button class="tag is-active" type="button">Aktiv</button>
      <span class="badge--item">tech-tagg</span>
    </div>
  </section>

  <section class="ds-section">
    <h2>Paper-section</h2>
    <div class="paper-section">
      <h2>Rubrik i paper-section</h2>
      <p>
        Yta med kantlinje, mjuk skugga och rundade hörn. Används för
        innehållsblock som bio och artiklar.
      </p>
    </div>
  </section>

  <section class="ds-section">
    <h2>Kort</h2>
    <ul role="list" class="link-card-grid">
      <li class="card">
        <a class="card__link" href="#">
          <div class="card__img" style="aspect-ratio:16/9;background:var(--c-border)"></div>
          <h3 class="card__title">Projekttitel</h3>
          <p class="card__txt">Kort beskrivning av projektet och vad det gör.</p>
        </a>
      </li>
      <li class="card">
        <a class="card__link" href="#">
          <div class="card__img" style="aspect-ratio:16/9;background:var(--c-border)"></div>
          <h3 class="card__title">Andra projektet</h3>
          <p class="card__txt">Hover lyfter kortet och markerar kanten i accent.</p>
        </a>
      </li>
    </ul>
  </section>
</Layout>
