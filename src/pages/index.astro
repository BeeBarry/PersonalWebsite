---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import profilePic from '../assets/images/profilepic.png';
import { showEntry } from '../utils/content';

const pageTitle = "Barry Namdari";

// Urval till landningssidan. showEntry döljer drafts i prod, visar i dev.
const projects = (await getCollection('projects', showEntry)).slice(0, 6);

// Posterna använder datumformatet "DD-MM-YYYY" → parsa för korrekt sortering.
const parseDate = (d: string): number => {
    const [day, month, year] = d.split('-').map(Number);
    return new Date(year ?? 0, (month ?? 1) - 1, day ?? 1).getTime();
};
const posts = (await getCollection('posts', showEntry))
    .sort((a, b) => parseDate(b.data.date) - parseDate(a.data.date))
    .slice(0, 6);
---
<Layout pageTitle={pageTitle} containerType="default">
    <section class="hero">
        <div class="profile-container hero__img">
            <Image class="profile-image" src={profilePic} alt="Barry Namdari" width={440} />
        </div>
        <div class="hero__body">
            <p>
                Barry är lärare och fotbollstränare som blev <strong>cloud- och
                infrastructure-engineer</strong>. Numera bygger han skalbar
                infrastruktur med inriktning mot <strong>IoT</strong> och tar med
                sig ledarskapet och pedagogiken från planen och klassrummet in i
                tekniken. Och ja — han är en rejäl nörd.
            </p>
            <ul class="hero-social">
                <li>
                    <a class="hero-social__link" href="https://github.com/BeeBarry" target="_blank" rel="noopener">
                        <img class="hero-social__icon" src="/github-mark-white.svg" alt="" width="20" height="20" />
                        <span>GitHub</span>
                    </a>
                </li>
                <li>
                    <a class="hero-social__link" href="https://www.linkedin.com/in/barryolofnamdari/" target="_blank" rel="noopener">
                        <img class="hero-social__icon" src="/li-in-white.png" alt="" width="20" height="20" />
                        <span>LinkedIn</span>
                    </a>
                </li>
            </ul>
        </div>
    </section>

    <section class="showcase">
        <div class="showcase__col">
            <h2 class="showcase__title">Projekt</h2>
            <p class="showcase__lead">Ett urval av vad jag byggt — klicka för att läsa mer.</p>
            <ul class="showcase__list">
                {projects.map((project) => (
                    <li class="showcase__item">
                        <a class="showcase__row" href={`/projects/${project.id}/`}>
                            <span class="showcase__name">{project.data.title}</span>
                            <p class="showcase__desc">{project.data.description}</p>
                        </a>
                    </li>
                ))}
            </ul>
            <a class="showcase__more" href="/works/">Se alla projekt →</a>
        </div>

        <div class="showcase__col">
            <h2 class="showcase__title">Blogg</h2>
            <p class="showcase__lead">Lärdomar och teknik-djupdykningar från min resa.</p>
            {posts.length > 0 ? (
                <ul class="showcase__list">
                    {posts.map((post) => (
                        <li class="showcase__item">
                            <a class="showcase__row" href={`/posts/${post.id}/`}>
                                <span class="showcase__name">{post.data.title}</span>
                                {post.data.description && (
                                    <p class="showcase__desc">{post.data.description}</p>
                                )}
                            </a>
                        </li>
                    ))}
                </ul>
            ) : (
                <p class="showcase__empty">Inlägg är på väg — kika tillbaka snart.</p>
            )}
            <a class="showcase__more" href="/posts/">Till bloggen →</a>
        </div>
    </section>

