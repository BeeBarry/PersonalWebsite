---
import AppLayout from "../layouts/AppLayout.astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import profilePic from "../assets/images/profilepic.png";
import site from "../config/site";
import { domains } from "../data/domains";

// Kontaktsektionens adresser — samma källa som sidfoten/sidebaren.
const linkedin = site.social.find((s) => s.name === "LinkedIn")?.href ?? "#";
const mail = site.social.find((s) => s.name === "Mail")?.href ?? "#";
---

<AppLayout title={site.meta.title} description={site.meta.description}>
  <div class="animate-in mx-auto max-w-3xl p-6 lg:px-10 lg:py-12">
    <!-- Hero: leder med rollen, inte namnet (redundant givet lettermärke + URL).
         Profilbild, roll och certifikat hör ihop visuellt — certifikaten är
         ramlösa så de läses som meriter under rollen, inte som chips. -->
    <section class="mb-11">
      <div class="flex items-start gap-4">
        <div
          class="h-16 w-16 shrink-0 overflow-hidden rounded-full ring-1 ring-border"
        >
          <Image
            src={profilePic}
            alt="Barry Namdari"
            width={128}
            height={128}
            class="h-full w-full object-cover"
            loading="eager"
          />
        </div>
        <div class="min-w-0 pt-0.5">
          {/* Rollen är sidans h1 — mb-0 nollar h1:ns basmarginal från @layer base,
              och text-foreground i stället för accent: accentfärg på stor fet
              text blir skrikig och tappar kontrast. */}
          <h1
            class="mb-0 text-[1.5rem] leading-tight font-extrabold tracking-tight text-foreground"
          >
            {site.hero.role}
          </h1>
          {/* Certifikat: leverantörslogga (Iconify) + officiellt namn.
              Mindre och dämpade så de läses som meriter under rollen. */}
          <ul class="mt-2 flex flex-wrap gap-x-5 gap-y-1.5">
            {
              site.certs.map((c) => (
                <li class="inline-flex items-center gap-1.5">
                  <Icon name={c.icon} class="h-[17px] w-[17px] shrink-0" />
                  <span class="text-[12px] font-medium text-foreground/80">
                    {c.name}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- Ingång till Teknik-guiden (HR-fliken) — riktad till rekryterare.
           Indraget till hero-textens vänsterkant (bildens 4rem + gap 1rem) och
           hållen smal, så den läser som en sidoingång och inte som ett block i
           huvudflödet. -->
      <div class="mt-6 sm:ml-20">
        <a
          href="/for-hr/"
          class="group flex items-center gap-3 rounded-xl border border-border bg-muted/10 p-3.5 transition-all hover:-translate-y-0.5 hover:border-primary/40 hover:bg-muted/20 sm:w-[23rem] lg:p-4"
        >
          <span
            class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-primary/12 text-primary"
          >
            <Icon name="mdi:account-group-outline" class="h-[18px] w-[18px]" />
          </span>
          <span class="min-w-0 flex-1">
            <span class="block text-[13px] font-bold text-foreground"
              >Rekryterar du inom tech?</span
            >
            <span class="mt-0.5 block text-[12px] leading-relaxed text-muted-foreground"
              >Teknik-guiden är skriven för HR — ingen förkunskap krävs.</span
            >
          </span>
          <span
            class="shrink-0 text-primary transition-transform group-hover:translate-x-0.5"
          >
            <Icon name="mdi:arrow-right" />
          </span>
        </a>
      </div>
    </section>

    <!-- Inriktningar: det unika, lyft högt -->
    <section class="mb-11">
      <h2
        class="mb-4 font-mono text-[10px] tracking-[0.22em] text-muted-foreground/50 uppercase"
      >
        Inriktningar
      </h2>
      <div class="grid gap-3 sm:grid-cols-3">
        {
          domains.map((d) => (
            <div class="rounded-xl border border-border bg-muted/10 p-4">
              <div class="flex items-center gap-2">
                {d.icon && (
                  <Icon name={d.icon} class="h-[18px] w-[18px] shrink-0 text-primary" />
                )}
                <h3 class="text-[13px] font-bold text-foreground">{d.short}</h3>
              </div>
              <p class="mt-2 text-[12.5px] leading-relaxed text-muted-foreground">
                {d.description}
              </p>
              <ul class="mt-3 space-y-1.5 border-t border-border/60 pt-3">
                {d.bullets.map((b) => (
                  <li class="flex gap-2 text-[12px] leading-relaxed text-muted-foreground">
                    <span class="text-primary/70" aria-hidden="true">
                      –
                    </span>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Om -->
    <section class="mb-11">
      <h2
        class="mb-3 font-mono text-[10px] tracking-[0.22em] text-muted-foreground/50 uppercase"
      >
        Om
      </h2>
      {/* Måttet hålls kring 70 tecken trots bredare spalt — löptext blir svårläst
          långt före containerns kant. */}
      {
        site.about.map((p) => (
          <p class="mb-3 max-w-[68ch] text-[14px] leading-relaxed text-muted-foreground last:mb-0">
            {p}
          </p>
        ))
      }
    </section>

    <!-- Verktyg & tekniker: grupperade. Rena färgade loggor, ingen container/hover -->
    <section class="mb-11">
      <h2
        class="mb-5 font-mono text-[10px] tracking-[0.22em] text-muted-foreground/50 uppercase"
      >
        Verktyg &amp; tekniker
      </h2>
      {/* Grupperna ligger horisontellt bredvid varandra och posterna vertikalt
          inom varje — utnyttjar den bredare spalten och gör grupptillhörigheten
          läsbar i en blick, i stället för fyra wrappande rader under varandra. */}
      <div class="grid gap-x-6 gap-y-7 sm:grid-cols-2 lg:grid-cols-4">
        {
          site.stackGroups.map((group) => (
            <div>
              <h3 class="mb-3 text-[11.5px] font-semibold tracking-wide text-foreground/75">
                {group.title}
              </h3>
              <ul class="space-y-2.5">
                {group.items.map((t) => (
                  <li class="flex items-center gap-2 text-[12.5px] text-muted-foreground">
                    <Icon name={t.icon} class="h-[18px] w-[18px] shrink-0" />
                    <span class="truncate">{t.name}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Utforska -->
    <nav class="border-t border-border pt-6">
      <div class="flex flex-wrap gap-x-6 gap-y-2 text-[13px]">
        <a
          href="/works/"
          class="group inline-flex items-center gap-1.5 text-muted-foreground transition-colors hover:text-primary"
          >Arbete <Icon
            name="mdi:arrow-right"
            class="transition-transform group-hover:translate-x-0.5"
          /></a
        >
        <a
          href="/posts/"
          class="group inline-flex items-center gap-1.5 text-muted-foreground transition-colors hover:text-primary"
          >Fältnoteringar <Icon
            name="mdi:arrow-right"
            class="transition-transform group-hover:translate-x-0.5"
          /></a
        >
        <a
          href="/learn-hub/"
          class="group inline-flex items-center gap-1.5 text-muted-foreground transition-colors hover:text-primary"
          >Learn Hub <Icon
            name="mdi:arrow-right"
            class="transition-transform group-hover:translate-x-0.5"
          /></a
        >
      </div>
    </nav>

    <!-- Kontakt: sidans avslut. Adresserna kommer ur site.social. -->
    <section class="mt-8 rounded-xl border border-border bg-primary/8 p-5">
      <h2
        class="mt-0 mb-0 font-mono text-[10px] tracking-[0.22em] text-muted-foreground/60 uppercase"
      >
        Kontakt
      </h2>
      <p class="mt-2.5 text-[16px] leading-snug font-bold text-foreground">
        Rekryterar du just nu?
      </p>
      <p class="mt-2 max-w-[52ch] text-[13px] leading-relaxed text-muted-foreground">
        Jag är nyexaminerad fullstack- och cloudutvecklare och söker mitt
        första jobb — junior roll, trainee eller praktik. Hör av dig så
        berättar jag mer.
      </p>
      <div class="mt-4 flex flex-wrap gap-2.5">
        <a
          href={linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center rounded-lg border border-primary bg-primary px-4 text-[13px] font-semibold text-primary-foreground transition-opacity hover:opacity-90"
        >
          Kontakta mig på LinkedIn
        </a>
        <a
          href={mail}
          class="inline-flex min-h-11 items-center rounded-lg border border-border px-4 text-[13px] font-semibold text-foreground transition-colors hover:border-primary"
        >
          Skicka ett mejl
        </a>
      </div>
    </section>

    <!-- Footer -->
    <footer
      class="mt-8 flex items-center justify-between border-t border-border pt-6 font-mono text-[10px] tracking-widest text-muted-foreground/40 uppercase"
    >
      <span>{site.footer.copyright}</span>
      <span>{site.footer.builtWith}</span>
    </footer>
  </div>
</AppLayout>
