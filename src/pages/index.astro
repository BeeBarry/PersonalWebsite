---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import profilePic from '../assets/images/profilepic.png';
const pageTitle = "Barry Namdari";
---
<Layout pageTitle={pageTitle} containerType="default">
    <section class="hero">
        <div class="profile-container hero__img">
            <Image class="profile-image" src={profilePic} alt="Barry Namdari" width={440} />
        </div>
        <div class="hero__body">
            <p>
                Barry är lärare och fotbollstränare som blev <strong>cloud- och
                infrastructure-engineer</strong>. Numera bygger han skalbar
                infrastruktur med inriktning mot <strong>IoT</strong> och tar med
                sig ledarskapet och pedagogiken från planen och klassrummet in i
                tekniken. Och ja — han är en rejäl nörd.
            </p>
            <ul class="hero-social">
                <li>
                    <a class="hero-social__link" href="https://github.com/BeeBarry" target="_blank" rel="noopener">
                        <img class="hero-social__icon" src="/github-mark-white.svg" alt="" width="20" height="20" />
                        <span>GitHub</span>
                    </a>
                </li>
                <li>
                    <a class="hero-social__link" href="https://www.linkedin.com/in/barryolofnamdari/" target="_blank" rel="noopener">
                        <img class="hero-social__icon" src="/li-in-white.png" alt="" width="20" height="20" />
                        <span>LinkedIn</span>
                    </a>
                </li>
            </ul>
        </div>
    </section>

    <div class="center">
        <a href="/works/">
            <button class="btn">Se portfolio</button>
        </a>
    </div>
    <h2>Vad jag hittills lärt mig:</h2>
    <div class="skills center">
        <img class="skills__img" width="55" height="55" alt="C#" src="https://api.iconify.design/skill-icons/cs.svg"/>

<img class="skills__img" width="55" height="55" alt="DotNet" src="https://api.iconify.design/skill-icons/dotnet.svg"/>

<img class="skills__img" width="55" height="55" alt="JavaScript" src="https://api.iconify.design/skill-icons/javascript.svg"/>

<img class="skills__img" width="55" height="55" alt="CSS" src="https://api.iconify.design/skill-icons/css.svg"/>


<img class="skills__img" width="55" height="55" alt="HTML" src="https://api.iconify.design/skill-icons/html.svg"/>

<img class="skills__img" width="55" height="55" alt="Azure" src="https://api.iconify.design/skill-icons/azure-light.svg"/>

<img class="skills__img" width="55" height="55" alt="Terraform" src="https://api.iconify.design/skill-icons/terraform-light.svg"/>

<img class="skills__img" width="55" height="55" alt="Docker" src="https://api.iconify.design/skill-icons/docker.svg"/>

<img class="skills__img" width="55" height="55" alt="GitLab" src="https://api.iconify.design/skill-icons/gitlab-light.svg"/>

<img class="skills__img" width="55" height="55" alt="Git" src="https://api.iconify.design/skill-icons/git.svg"/>

<img class="skills__img" width="55" height="55" alt="GitHub" src="https://api.iconify.design/skill-icons/github-light.svg"/>

<img class="skills__img" width="55" height="55" alt="GitHub Actions" src="https://skillicons.dev/icons?i=githubactions"/>



<img class="skills__img" width="55" height="55" alt="Postman" src="https://api.iconify.design/skill-icons/postman.svg"/>

<img class="skills__img" width="55" height="55" alt="MongoDB" src="https://api.iconify.design/skill-icons/mongodb.svg"/>

<img class="skills__img" width="55" height="55" alt="NodeJS" src="https://api.iconify.design/skill-icons/nodejs-light.svg"/>


<img class="skills__img" width="55" height="55" alt="Bootstrap" src="https://api.iconify.design/skill-icons/bootstrap.svg"/>


<img class="skills__img" width="55" height="55" alt="SQL Server" src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/microsoftsqlserver/microsoftsqlserver-plain-wordmark.svg"/>

<img class="skills__img" width="55" height="55" alt="SQL Server" src="https://symbols.getvecta.com/stencil_28/61_sql-database-generic.90b41636a8.svg"/>



    </div>
    <h2></h2>
    <p>

    </p>
</Layout>


