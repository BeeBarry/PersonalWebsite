---
import AppLayout from "../layouts/AppLayout.astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import profilePic from "../assets/images/profilepic.png";
import site from "../config/site";
import { domains } from "../data/domains";

// Kontaktsektionens adresser — samma källa som sidfoten/sidebaren.
const linkedin = site.social.find((s) => s.name === "LinkedIn")?.href ?? "#";
const mail = site.social.find((s) => s.name === "Mail")?.href ?? "#";
---

<AppLayout title={site.meta.title} description={site.meta.description}>
  <div class="animate-in mx-auto max-w-3xl p-6 lg:px-10 lg:py-12">
    <!-- Hero: leder med rollen, inte namnet (redundant givet lettermärke + URL).
         Profilbild, roll och certifikat hör ihop visuellt — certifikaten är
         ramlösa så de läses som meriter under rollen, inte som chips. -->
    <section class="mb-11">
      {/* Hero:t är sidans översta hierarkinivå och var tidigare bara ett par
          punkter större än brödtexten. Bild 64→80, rubrik 24→28, certifikat
          12→13 — steget till avsnittsrubrikerna (10px mono) och brödtexten
          (14px) är nu entydigt. */}
      <div class="flex items-start gap-4">
        <div
          class="h-20 w-20 shrink-0 overflow-hidden rounded-full ring-1 ring-border"
        >
          <Image
            src={profilePic}
            alt="Barry Namdari"
            width={160}
            height={160}
            class="h-full w-full object-cover"
            loading="eager"
          />
        </div>
        <div class="min-w-0 pt-1">
          {/* Rollen är sidans h1 — mb-0 nollar h1:ns basmarginal från @layer base,
              och text-foreground i stället för accent: accentfärg på stor fet
              text blir skrikig och tappar kontrast. */}
          <h1
            class="mb-0 text-[1.75rem] leading-tight font-extrabold tracking-tight text-foreground"
          >
            {site.hero.role}
          </h1>
          {/* Certifikat: leverantörslogga (Iconify) + officiellt namn.
              Mindre och dämpade så de läses som meriter under rollen. */}
          <ul class="mt-2.5 flex flex-wrap gap-x-5 gap-y-1.5">
            {
              site.certs.map((c) => (
                <li class="inline-flex items-center gap-1.5">
                  <Icon name={c.icon} class="h-[19px] w-[19px] shrink-0" />
                  <span class="text-[13px] font-medium text-foreground/80">
                    {c.name}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- Ingång till Teknik-guiden (HR-fliken) — riktad till rekryterare.
           Indraget till hero-textens vänsterkant (bildens 4rem + gap 1rem) och
           hållen smal, så den läser som en sidoingång och inte som ett block i
           huvudflödet. -->
      {/* ml-24, inte ml-20: indraget ska landa exakt på hero-textens vänsterkant,
          alltså bildens bredd (5rem) + gap (1rem). Med den större bilden hade
          det gamla måttet lämnat kortet 1rem för långt till vänster.
          Skalan är samtidigt sänkt ett steg — kortet är en sidoingång och ska
          ligga UNDER hero:t i hierarkin, inte konkurrera med det. */}
      <div class="mt-5 sm:ml-24">
        <a
          href="/for-hr/"
          class="group flex items-center gap-2.5 rounded-xl border border-border bg-muted/10 p-3 transition-all hover:-translate-y-0.5 hover:border-primary/40 hover:bg-muted/20 sm:w-[21rem]"
        >
          <span
            class="grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-primary/12 text-primary"
          >
            <Icon name="mdi:account-group-outline" class="h-4 w-4" />
          </span>
          <span class="min-w-0 flex-1">
            <span class="block text-[12.5px] font-bold text-foreground"
              >Rekryterar du inom tech?</span
            >
            <span class="mt-0.5 block text-[11.5px] leading-relaxed text-muted-foreground"
              >Teknik-guiden är skriven för HR — ingen förkunskap krävs.</span
            >
          </span>
          <span
            class="shrink-0 text-primary transition-transform group-hover:translate-x-0.5"
          >
            <Icon name="mdi:arrow-right" class="h-4 w-4" />
          </span>
        </a>
      </div>
    </section>

    <!-- Inriktningar: det unika, lyft högt -->
    <section class="mb-11">
      <h2
        class="mb-4 font-mono text-[10px] tracking-[0.22em] text-muted-foreground/50 uppercase"
      >
        Inriktningar
      </h2>
      {/* INGEN ram, ingen bakgrund, ingen rundning. Kortchromet var identiskt
          med ”Rekryterar du inom tech?”-kortet ovanför, som ÄR en länk — tre
          statiska textblock lovade alltså ett klick som inte finns. Utan lådan
          bär i stället accentlinjen överst strukturen: tre parallella streck
          läser som tre jämbördiga spår, och ingenting av det ser tryckbart ut.
          Ikonen och rubriken får bära blicken i stället för ramen. */}
      <div class="grid gap-x-7 gap-y-8 sm:grid-cols-3">
        {
          domains.map((d) => (
            <div class="border-t-2 border-primary/30 pt-3.5">
              {/* Ikonrutan är 20px för alla tre och centreras mot rubriken.
                  translate-y kompenserar att mdi-glyferna sitter systematiskt
                  ~2 av 24 enheter högt i sin viewBox — utan den läser ikonen
                  som lyft en aning över texten den hör till. */}
              <div class="flex items-center gap-2">
                {d.icon && (
                  <Icon
                    name={d.icon}
                    class="h-5 w-5 shrink-0 translate-y-[1.5px] text-primary"
                  />
                )}
                <h3 class="text-[15px] leading-tight font-extrabold tracking-tight text-foreground">
                  {d.short}
                </h3>
              </div>
              {/* Tre tydliga nivåer: rubrik 15 fet, beskrivning 13 i ljusare
                  text, punkter 11,5 dämpade. Förut låg beskrivning och punkter
                  på 12,5 respektive 12 i samma färg — en halv punkt isär, vilket
                  läses som ett enda textblock utan inbördes ordning. */}
              <p class="mt-2 text-[13px] leading-relaxed text-foreground/70">
                {d.description}
              </p>
              <ul class="mt-3.5 space-y-1.5">
                {d.bullets.map((b) => (
                  <li class="flex gap-2 text-[11.5px] leading-relaxed text-muted-foreground">
                    <span class="text-primary" aria-hidden="true">
                      –
                    </span>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Om -->
    <section class="mb-11">
      <h2
        class="mb-3 font-mono text-[10px] tracking-[0.22em] text-muted-foreground/50 uppercase"
      >
        Om
      </h2>
      {/* Måttet hålls kring 70 tecken trots bredare spalt — löptext blir svårläst
          långt före containerns kant. */}
      {
        site.about.map((p) => (
          <p class="mb-3 max-w-[68ch] text-[14px] leading-relaxed text-muted-foreground last:mb-0">
            {p}
          </p>
        ))
      }
    </section>

    <!-- Verktyg & tekniker: grupperade. Rena färgade loggor, ingen container/hover -->
    <section class="mb-11">
      <h2
        class="mb-5 font-mono text-[10px] tracking-[0.22em] text-muted-foreground/50 uppercase"
      >
        Verktyg &amp; tekniker
      </h2>
      {/* Grupperna ligger horisontellt bredvid varandra och posterna vertikalt
          inom varje — utnyttjar den bredare spalten och gör grupptillhörigheten
          läsbar i en blick, i stället för fyra wrappande rader under varandra. */}
      {/* Tre spalter, inte fyra: med fem grupper hade den femte blivit ensam
          kvar på rad två. 3×2 ger en jämn uppställning OCH en ledig plats där
          nästa grupp kan gå in utan att layouten behöver röras. */}
      <div class="grid gap-x-6 gap-y-7 sm:grid-cols-2 lg:grid-cols-3">
        {
          site.stackGroups.map((group) => (
            <div>
              <h3 class="mb-3 text-[11.5px] font-semibold tracking-wide text-foreground/75">
                {group.title}
              </h3>
              <ul class="space-y-2.5">
                {group.items.map((t) => (
                  <li class="flex items-center gap-2 text-[12.5px] text-muted-foreground">
                    <Icon name={t.icon} class="h-[18px] w-[18px] shrink-0" />
                    <span class="truncate">{t.name}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Utforska -->
    <nav class="border-t border-border pt-6">
      <div class="flex flex-wrap gap-x-6 gap-y-2 text-[13px]">
        <a
          href="/works/"
          class="group inline-flex items-center gap-1.5 text-muted-foreground transition-colors hover:text-primary"
          >Arbete <Icon
            name="mdi:arrow-right"
            class="transition-transform group-hover:translate-x-0.5"
          /></a
        >
        <a
          href="/posts/"
          class="group inline-flex items-center gap-1.5 text-muted-foreground transition-colors hover:text-primary"
          >Fältnoteringar <Icon
            name="mdi:arrow-right"
            class="transition-transform group-hover:translate-x-0.5"
          /></a
        >
        <a
          href="/learn-hub/"
          class="group inline-flex items-center gap-1.5 text-muted-foreground transition-colors hover:text-primary"
          >Learn Hub <Icon
            name="mdi:arrow-right"
            class="transition-transform group-hover:translate-x-0.5"
          /></a
        >
      </div>
    </nav>

    <!-- Kontakt: sidans avslut. Adresserna kommer ur site.social.
         Ingen ram — den gröna tonplattan räcker för att skilja blocket från
         flödet, och ram PÅ tonplatta blev två avgränsningar för samma sak.
         Skalan är sänkt till samma nivå som ”Rekryterar du inom tech?”-kortet
         överst (rubrik 14, brödtext 12,5): blocket var sidans största text
         trots att det ligger sist, och drog blicken förbi allt annat. -->
    <section class="mt-8 rounded-xl bg-primary/8 p-4">
      <h2
        class="mt-0 mb-0 font-mono text-[10px] tracking-[0.22em] text-muted-foreground/60 uppercase"
      >
        Kontakt
      </h2>
      <p class="mt-2 text-[14px] leading-snug font-bold text-foreground">
        Rekryterar du just nu?
      </p>
      <p class="mt-1.5 max-w-[52ch] text-[12.5px] leading-relaxed text-muted-foreground">
        Jag är nyexaminerad fullstack- och cloudutvecklare och söker mitt
        första jobb — junior roll, trainee eller praktik. Hör av dig så
        berättar jag mer.
      </p>
      {/* 40 px hög träffyta i stället för 44: med den mindre skalan blev 44 px
          höga knappar oproportionerligt tunga. WCAG 2.2 SC 2.5.8 kräver 24. */}
      <div class="mt-3.5 flex flex-wrap gap-2">
        <a
          href={linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-10 items-center rounded-lg border border-primary bg-primary px-3.5 text-[12.5px] font-semibold text-primary-foreground transition-opacity hover:opacity-90"
        >
          Kontakta mig på LinkedIn
        </a>
        <a
          href={mail}
          class="inline-flex min-h-10 items-center rounded-lg border border-border px-3.5 text-[12.5px] font-semibold text-foreground transition-colors hover:border-primary"
        >
          Skicka ett mejl
        </a>
      </div>
    </section>

    <!-- Footer -->
    <footer
      class="mt-8 flex items-center justify-between border-t border-border pt-6 font-mono text-[10px] tracking-widest text-muted-foreground/40 uppercase"
    >
      <span>{site.footer.copyright}</span>
      <span>{site.footer.builtWith}</span>
    </footer>
  </div>
</AppLayout>
