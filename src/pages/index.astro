---
import AppLayout from "../layouts/AppLayout.astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import profilePic from "../assets/images/profilepic.png";
import site from "../config/site";
import { domains } from "../data/domains";

// Kontaktsektionens adresser — samma källa som sidfoten/sidebaren.
const linkedin = site.social.find((s) => s.name === "LinkedIn")?.href ?? "#";
const mail = site.social.find((s) => s.name === "Mail")?.href ?? "#";
---

<AppLayout title={site.meta.title} description={site.meta.description}>
  <div class="animate-in mx-auto max-w-3xl p-6 lg:px-10 lg:py-12">
    <!-- Hero: leder med rollen, inte namnet (redundant givet lettermärke + URL).
         Profilbild, roll och certifikat hör ihop visuellt — certifikaten är
         ramlösa så de läses som meriter under rollen, inte som chips. -->
    <section class="mb-11">
      {/* Hero:t är sidans översta hierarkinivå och var tidigare bara ett par
          punkter större än brödtexten. Bild 64→80, rubrik 24→28, certifikat
          12→13 — steget till avsnittsrubrikerna (10px mono) och brödtexten
          (14px) är nu entydigt. */}
      <div class="flex items-start gap-4">
        <div
          class="h-20 w-20 shrink-0 overflow-hidden rounded-full ring-1 ring-border"
        >
          <Image
            src={profilePic}
            alt="Barry Namdari"
            width={160}
            height={160}
            class="h-full w-full object-cover"
            loading="eager"
          />
        </div>
        <div class="min-w-0 pt-1">
          {/* Rollen är sidans h1 — mb-0 nollar h1:ns basmarginal från @layer base,
              och text-foreground i stället för accent: accentfärg på stor fet
              text blir skrikig och tappar kontrast. */}
          <h1
            class="mb-0 text-[1.75rem] leading-tight font-extrabold tracking-tight text-foreground"
          >
            {site.hero.role}
          </h1>
          {/* Certifikat: leverantörslogga (Iconify) + officiellt namn.
              Mindre och dämpade så de läses som meriter under rollen. */}
          <ul class="mt-2.5 flex flex-wrap gap-x-5 gap-y-1.5">
            {
              site.certs.map((c) => (
                <li class="inline-flex items-center gap-1.5">
                  <Icon name={c.icon} class="h-[19px] w-[19px] shrink-0" />
                  <span class="text-[13px] font-medium text-foreground/80">
                    {c.name}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- Ingång till Teknik-guiden (HR-fliken) — riktad till rekryterare.
           Indraget till hero-textens vänsterkant (bildens 4rem + gap 1rem) och
           hållen smal, så den läser som en sidoingång och inte som ett block i
           huvudflödet. -->
      {/* Högerställd och nedskalad till en enda rad. Som kort på 21rem under
          hero:t låg den mitt i läsvägen och tog blicken före certifikaten —
          fast den är en sidoingång för en av flera besökartyper, inte sidans
          budskap. Högerkanten är den lugnaste platsen på en vänsterläst sida:
          den syns, men först efter rubrik och meriter. */}
      <div class="mt-4 flex justify-end">
        <a
          href="/for-hr/"
          class="group inline-flex items-center gap-2 rounded-full border border-border bg-muted/10 py-1.5 pr-2.5 pl-3 transition-colors hover:border-primary/40 hover:bg-muted/20"
        >
          <Icon
            name="mdi:account-group-outline"
            class="h-[15px] w-[15px] shrink-0 text-primary"
          />
          <span class="text-[11.5px] text-muted-foreground">
            Rekryterar du inom tech? <span class="font-semibold text-foreground"
              >Läs Teknik-guiden</span
            >
          </span>
          <Icon
            name="mdi:arrow-right"
            class="h-[14px] w-[14px] shrink-0 text-primary transition-transform group-hover:translate-x-0.5"
          />
        </a>
      </div>
    </section>

    <!-- Inriktningar: det unika, lyft högt -->
    <section class="mb-11">
      {/* SEKTIONSRUBRIKEN — 12px/85%. Måttet delas av alla fyra sektionerna på
          sidan (Inriktningar, Om, Verktyg & tekniker, Kontakt) och får inte
          ändras på en av dem i taget.

          Den låg tidigare på 10px/50% medan gruppetiketterna inne i ”Verktyg &
          tekniker” låg på 9,5px/70%: sektionsrubriken var alltså en halv pixel
          större men LJUSSVAGARE än sina egna underrubriker, och lästes därför
          som ett syskon till dem i stället för som en nivå över.

          Steget togs uppåt, inte nedåt. Att dämpa gruppetiketten till 55% hade
          gett samma skillnad men tagit den till 3,48:1 mot panelen — under WCAG
          AA för 9,5 px text. 85% ger sektionsrubriken 6,57:1 mot gruppens
          4,88:1, och båda klarar AA. */}
      <h2
        class="mb-4 font-mono text-[12px] tracking-[0.2em] text-muted-foreground/85 uppercase"
      >
        Inriktningar
      </h2>
      {/* Ingen ram, ingen bakgrund, ingen rundning — kortchromet var identiskt
          med den länk som låg ovanför, så tre statiska textblock lovade ett
          klick som inte finns. Ikonen och den feta rubriken bär strukturen i
          stället. Kolumnerna hålls isär av gapet allena. */}
      <div class="grid gap-x-7 gap-y-8 sm:grid-cols-3">
        {
          domains.map((d) => (
            <div>
              {/* -2,5px är uppmätt, inte gissat. items-center linjerar ikonens
                  och rubrikens RUTOR, men ögat linjerar mot versalhöjden — och
                  textrutan bär nedhängsutrymme som versalerna inte fyller.
                  Mätt låg ikonens bläckmitt 3,9–4,2 px UNDER rubrikens
                  versalmitt på alla tre kolumnerna. -2,5px nollar det (tidigare
                  +1,5 gick åt fel håll). Byter du ikon: mät om, se domains.ts. */}
              <div class="flex items-center gap-2">
                {d.icon && (
                  <Icon
                    name={d.icon}
                    class="h-5 w-5 shrink-0 -translate-y-[2.5px] text-primary"
                  />
                )}
                <h3 class="text-[15px] leading-tight font-extrabold tracking-tight text-foreground">
                  {d.short}
                </h3>
              </div>
              {/* Tre tydliga nivåer: rubrik 15 fet, beskrivning 13 i ljusare
                  text, punkter 11,5 dämpade. Förut låg beskrivning och punkter
                  på 12,5 respektive 12 i samma färg — en halv punkt isär, vilket
                  läses som ett enda textblock utan inbördes ordning. */}
              <p class="mt-2 text-[13px] leading-relaxed text-foreground/70">
                {d.description}
              </p>
              <ul class="mt-3.5 space-y-1.5">
                {d.bullets.map((b) => (
                  <li class="flex gap-2 text-[11.5px] leading-relaxed text-muted-foreground">
                    <span class="text-primary" aria-hidden="true">
                      –
                    </span>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Om -->
    <section class="mb-11">
      <h2
        class="mb-4 font-mono text-[12px] tracking-[0.2em] text-muted-foreground/85 uppercase"
      >
        Om
      </h2>
      {/* Måttet hålls kring 70 tecken trots bredare spalt — löptext blir svårläst
          långt före containerns kant. */}
      {
        site.about.map((p) => (
          <p class="mb-3 max-w-[68ch] text-[14px] leading-relaxed text-muted-foreground last:mb-0">
            {p}
          </p>
        ))
      }
    </section>

    <!-- Verktyg & tekniker: grupperade. Rena färgade loggor, ingen container/hover -->
    <section class="mb-11">
      <h2
        class="mb-4 font-mono text-[12px] tracking-[0.2em] text-muted-foreground/85 uppercase"
      >
        Verktyg &amp; tekniker
      </h2>
      {/* Grupperna ligger horisontellt bredvid varandra och posterna vertikalt
          inom varje — utnyttjar den bredare spalten och gör grupptillhörigheten
          läsbar i en blick, i stället för fyra wrappande rader under varandra. */}
      {/* SPALTFLÖDE, inte grid. Grupperna är olika långa (5, 5, 8, 4, 6 poster),
          och i ett grid får varje RAD höjden av sin längsta cell: rad ett
          sträcktes till åtta poster för Cloud & DevOps skull, så Språk och
          Frameworks lämnade 92 px tomt var innan rad två började. Uppmätt total
          död yta: 246 px. Det var det som läste som osymmetriskt.

          Ett flerspaltsflöde har inga rader att linjera, så nästa grupp börjar
          direkt under den föregående i samma spalt och webbläsaren balanserar
          spalthöjderna. Motsatt slutsats mot ordlistan i hr.css — där gällde
          måttet RADER som måste linjera mellan spalterna, här är varje grupp ett
          eget block där bara posterna inom gruppen behöver linjera.

          break-inside: avoid håller en grupp samlad; utan den kunde en rubrik
          hamna sist i en spalt och sina poster först i nästa. */}
      <div class="columns-1 gap-x-6 sm:columns-2 lg:columns-3">
        {
          site.stackGroups.map((group) => (
            <div class="mb-7 break-inside-avoid last:mb-0">
              {/* Gruppnamnet är en ETIKETT, inte innehåll — det körs därför i
                  sajtens etikettidiom (mono, versaler, dämpad), samma som
                  ”Verktyg & tekniker” en nivå upp. Förut låg det på
                  foreground/75 halvfet och posterna på muted: knappt någon
                  skillnad, så rubrik och innehåll flöt ihop till ett block.
                  Nu skiljer de sig på fyra sätt samtidigt — familj, storlek,
                  versalgemen och ljushet.

                  70% är ett GOLV, inte en smaksak: 9,5 px mono på panelens
                  bakgrund ger 4,88:1 här, och 55% hade tagit det till 3,48:1 —
                  under WCAG AA. Hierarkin mot sektionsrubriken löses därför
                  uppåt (h2 till 85%), inte genom att dämpa den här. */}
              <h3 class="mb-3 font-mono text-[9.5px] tracking-[0.14em] text-muted-foreground/70 uppercase">
                {group.title}
              </h3>
              {/* foreground/90: posterna är innehållet och ska vara ljusast i
                  sektionen. Det lyfter dessutom de enfärgade ikonerna, som
                  ärver currentColor — nRF, Zephyr, SQL och protokollen var
                  tidigare lika dämpade som brödtext. */}
              <ul class="space-y-2.5">
                {group.items.map((t) => (
                  <li class="flex items-center gap-2 text-[12.5px] text-foreground/90">
                    <Icon name={t.icon} class="h-[18px] w-[18px] shrink-0" />
                    <span class="truncate">{t.name}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    {/* ”Utforska”-raden borttagen: Arbete, Fältnoteringar och Learn Hub finns
        redan i vänsternavigeringen, som står kvar hela tiden. Raden var en
        andra uppsättning av samma vägar. */}

    <!-- Kontakt: sidans avslut. Adresserna kommer ur site.social.
         Ingen ram — den gröna tonplattan räcker för att skilja blocket från
         flödet, och ram PÅ tonplatta blev två avgränsningar för samma sak.
         Skalan är sänkt till samma nivå som ”Rekryterar du inom tech?”-kortet
         överst (rubrik 14, brödtext 12,5): blocket var sidans största text
         trots att det ligger sist, och drog blicken förbi allt annat. -->
    <section class="mt-8 rounded-xl bg-primary/8 p-4">
      <h2
        class="mt-0 mb-0 font-mono text-[12px] tracking-[0.2em] text-muted-foreground/85 uppercase"
      >
        Kontakt
      </h2>
      {/* Rubriken följer med texten: ”Rekryterar du just nu?” handlade om
          anställning, och stod kvar hade den motsagt stycket under. */}
      <p class="mt-2 text-[14px] leading-snug font-bold text-foreground">
        Har ni ett uppdrag på gång?
      </p>
      <p class="mt-1.5 max-w-[56ch] text-[12.5px] leading-relaxed text-muted-foreground">
        Jag är tillgänglig för uppdrag som utvecklare, projektledare eller
        utbildare. Hör av dig så tar vi ett samtal om var det skaver i er
        organisation — och vad som skulle kunna lösa det.
      </p>
      {/* 40 px hög träffyta i stället för 44: med den mindre skalan blev 44 px
          höga knappar oproportionerligt tunga. WCAG 2.2 SC 2.5.8 kräver 24. */}
      <div class="mt-3.5 flex flex-wrap gap-2">
        <a
          href={linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-10 items-center rounded-lg border border-primary bg-primary px-3.5 text-[12.5px] font-semibold text-primary-foreground transition-opacity hover:opacity-90"
        >
          Kontakta mig på LinkedIn
        </a>
        <a
          href={mail}
          class="inline-flex min-h-10 items-center rounded-lg border border-border px-3.5 text-[12.5px] font-semibold text-foreground transition-colors hover:border-primary"
        >
          Skicka ett mejl
        </a>
      </div>
    </section>

    <!-- Footer. Bara copyright kvar — "byggd med astro" borttaget. -->
    <footer
      class="mt-8 border-t border-border pt-6 font-mono text-[10px] tracking-widest text-muted-foreground/40 uppercase"
    >
      <span>{site.footer.copyright}</span>
    </footer>
  </div>
</AppLayout>
