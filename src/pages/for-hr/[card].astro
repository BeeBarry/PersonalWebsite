---
// Kort-detaljvy — en egen prerenderad sida per kort (djuplänkbar från LinkedIn:
// /for-hr/kubernetes). Den persistenta topbaren (HrTabBar) ligger kvar överst
// med tillbaka-knapp + kort-switcher. Fulla kort får en dokument-layout: artikel
// + sticky innehållsförteckning (scroll-spy) som fyller ytan och ger överblick.
// Utkast (utan `what`) visar ett "på gång"-block.
//
// LAYOUTEN ÄR EN MOSAIK, inte en spalt. Varje sektion är ett block (`.hrd-block`)
// och blocken läggs i rader: full bredd när texten är lång, två i bredd när den
// är kort. Skälet är läsbarhet över scroll — en enda kolumn med identisk bredd,
// vänsterkant och densitet blir enformig efter tre skärmar, och kortet har sju
// sektioner.
//
// EN rad = EN post i innehållsförteckningen. Två sektioner sida vid sida får
// identisk offsetTop, och scroll-spyn (toc.ts) låter den sista av likvärdiga
// träffar vinna — vänsterkortet hade aldrig kunnat markeras. Därför bär raden
// id:t, inte de enskilda blocken.
import AppLayout from "../../layouts/AppLayout.astro";
import HrTabBar from "../../components/hr/HrTabBar.astro";
import ArticleToc from "../../components/site/ArticleToc.astro";
import Icon from "../../components/site/Icon.astro";
import { TOC_MIN_ITEMS } from "../../scripts/toc";
import site from "../../config/site";
import { hrCards, isDraft, doneCards, faqForCard, typo } from "../../data/hr";
import "../../styles/hr.css";

export const prerender = true;
export function getStaticPaths() {
  return hrCards.map((card) => ({ params: { card: card.id }, props: { card } }));
}

const { card } = Astro.props;
const draft = isDraft(card);
const faqs = faqForCard(card.id);

// Utkastsidan ska inte vara en återvändsgränd: peka på de kort som faktiskt är
// skrivna (hämtas dynamiskt, så raden aldrig blir inaktuell).
const readyCards = doneCards().filter((c) => c.id !== card.id).slice(0, 3);

const linkedin = site.social.find((s) => s.name === "LinkedIn")?.href ?? "#";
const github = site.social.find((s) => s.name === "GitHub")?.href ?? "#";

const pageTitle = `${card.title} · Teknik-guiden`;

// Rubriken på översiktsblocket följer taxonomin: en roll GÖR något, ett verktyg
// ÄR något. Härlett ur `typ` i stället för ett eget fält — samma skillnad som
// biblioteket redan grupperar på.
const isRole = card.typ === "Roll";
const overviewTitle = isRole ? "Vad rollen gör" : `Vad ${card.title} är`;

// Faktaraden svarar på rekryterarens tre första frågor innan hon scrollat.
// Tredje cellen är guidens tes: roller sätts i annonsrubriken, allt annat
// listas som färdighet. Den står uttryckligen i innehållet (se `confuse` på
// Kubernetes och Frontend, och FAQ f4) och härleds här ur `typ` — det finns
// medvetet inget nivåspann här, eftersom årtalen bara finns på en del kort och
// guiden själv avråder från år som mätare.
const facts = [
  { k: "Typ", v: card.typ },
  { k: "Var i produkten", v: card.dom },
  { k: "I annonsen", v: isRole ? "Sätt i rubriken" : "Lista som färdighet" },
];

// Innehållsförteckning — en post per RAD (se noten överst om scroll-spy), och
// bara de rader kortet faktiskt har.
const hasProfile = !!card.tasks?.length || !!card.fits?.length;
const toc = [
  { id: "oversikt", label: "Översikt", show: true },
  { id: "arbetsdag", label: "En vanlig arbetsdag", show: hasProfile },
  { id: "blandas", label: "Blandas ihop med", show: !!card.confuse?.length },
  { id: "fragor", label: "Frågor att ställa", show: !!card.ask?.length },
  { id: "niva", label: "Junior eller senior?", show: !!(card.junior || card.senior) },
  { id: "cv", label: "Ord i CV:t", show: !!card.cv?.length },
  { id: "faq", label: "Vanliga frågor", show: faqs.length > 0 },
]
  .filter((t) => t.show)
  .map(({ id, label }) => ({ id, label }));
const showToc = !draft && toc.length >= TOC_MIN_ITEMS;
---

<AppLayout title={pageTitle} description={card.one} image="/og-hr.png">
  <div class="hr">
    <HrTabBar variant="detail" current={card.id} />

    <div class="site reader">
      {
        draft ? (
          <article class="article hrd animate-in">
            <p class="hrd__meta">{card.typ} · {card.dom}</p>
            <h1 class="hrd__title">{card.title}</h1>
            <div class="hrd-draft">
              <p class="hrd-draft__title">Kortet är på gång</p>
              <p class="hrd-draft__text">
                {typo(card.one)} Det fullständiga kortet skriver jag som bäst —
                vill du att jag prioriterar det, hör av dig så taggar jag dig när
                det ligger uppe.
              </p>
              {readyCards.length > 0 && (
                <div class="hrd-draft__ready">
                  <p class="hrd-draft__readylabel">Läs ett färdigt kort så länge</p>
                  <div class="hrd-draft__links">
                    {readyCards.map((c) => (
                      <a class="hrd-draft__link" href={`/for-hr/${c.id}/`}>
                        {c.title}
                        <Icon name="ArrowRight" size={13} />
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </div>
            <div class="hrd-actions">
              <a class="hr-btn" href={linkedin} target="_blank" rel="noopener noreferrer">
                <Icon name="Users" size={15} />
                Fråga mig om kortet
              </a>
              <a class="hrd-actions__icon" href={github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
                <Icon name="Github" size={18} />
              </a>
            </div>
          </article>
        ) : (
          <div class:list={["hrd-doc animate-in", showToc && "hrd-doc--toc"]}>
            <article class="hrd-main">
              <p class="hrd__meta">{card.typ} · {card.dom}</p>
              <h1 class="hrd__title">{card.title}</h1>

              {showToc && <ArticleToc items={toc} variant="jump" />}

              <p class="hrd__lead">{typo(card.one)}</p>

              <div class="hrd-facts">
                {facts.map((f) => (
                  <div class="hrd-fact">
                    <p class="hrd-fact__k">{f.k}</p>
                    <p class="hrd-fact__v">{f.v}</p>
                  </div>
                ))}
              </div>

              <div class="hrd-row" id="oversikt">
                <section class="hrd-block">
                  <h2 class="hrd-block__h">{overviewTitle}</h2>
                  <p class="hrd-text">{typo(card.what)}</p>
                  {card.analogy && (
                    <>
                      <p class="hrd-label">Tänk så här</p>
                      <p class="hrd-analogy">{typo(card.analogy)}</p>
                    </>
                  )}
                </section>
              </div>

              {hasProfile && (
                <div class="hrd-row hrd-row--2" id="arbetsdag">
                  {card.tasks && card.tasks.length > 0 && (
                    <section class="hrd-block">
                      <h2 class="hrd-block__h">En vanlig arbetsdag</h2>
                      <ul class="hrd-list hrd-list--tasks">
                        {card.tasks.map((t) => (
                          <li>{typo(t)}</li>
                        ))}
                      </ul>
                    </section>
                  )}
                  {card.fits && card.fits.length > 0 && (
                    <section class="hrd-block">
                      <h2 class="hrd-block__h">Passar en person som</h2>
                      <ul class="hrd-list hrd-list--fits">
                        {card.fits.map((f) => (
                          <li>{typo(f)}</li>
                        ))}
                      </ul>
                    </section>
                  )}
                </div>
              )}

              {card.confuse && card.confuse.length > 0 && (
                <div class="hrd-row" id="blandas">
                  <section class="hrd-block">
                    <h2 class="hrd-block__h">
                      Blandas ofta ihop med
                      {card.confuse.length > 1 && (
                        <span class="hrd-block__n">{card.confuse.length} par</span>
                      )}
                    </h2>
                    <div class="hrd-sub">
                      {card.confuse.map((c) => (
                        <div class="hrd-item">
                          <p class="hrd-item__t">{typo(c.a)}</p>
                          <p class="hrd-text">{typo(c.b)}</p>
                        </div>
                      ))}
                    </div>
                  </section>
                </div>
              )}

              {card.ask && card.ask.length > 0 && (
                <div class="hrd-row" id="fragor">
                  <section class="hrd-block">
                    <h2 class="hrd-block__h">
                      Frågor du kan ställa
                      {card.ask.length > 1 && (
                        <span class="hrd-block__n">{card.ask.length} frågor</span>
                      )}
                    </h2>
                    <div class="hrd-sub hrd-sub--q">
                      {card.ask.map((a) => (
                        <div class="hrd-item">
                          <p class="hrd-item__t">”{typo(a.q)}”</p>
                          <p class="hrd-label">Bra svar</p>
                          <p class="hrd-text">{typo(a.good)}</p>
                        </div>
                      ))}
                    </div>
                  </section>
                </div>
              )}

              {(card.junior || card.senior) && (
                <div class="hrd-row" id="niva">
                  <section class="hrd-block">
                    <h2 class="hrd-block__h">Junior eller senior?</h2>
                    <div class="hrd-sub">
                      {card.junior && (
                        <div class="hrd-item">
                          <p class="hrd-label hrd-label--top">Junior</p>
                          <p class="hrd-text">{typo(card.junior)}</p>
                        </div>
                      )}
                      {card.senior && (
                        <div class="hrd-item">
                          <p class="hrd-label hrd-label--top">Senior</p>
                          <p class="hrd-text">{typo(card.senior)}</p>
                        </div>
                      )}
                    </div>
                  </section>
                </div>
              )}

              {card.cv && card.cv.length > 0 && (
                <div class="hrd-row" id="cv">
                  <section class="hrd-block">
                    <h2 class="hrd-block__h">Ord du ser i CV:t</h2>
                    <div class="hrd-cv">
                      {card.cv.map((word) => (
                        <span>{word}</span>
                      ))}
                    </div>
                  </section>
                </div>
              )}

              {faqs.length > 0 && (
                <div class="hrd-row" id="faq">
                  <section class="hrd-block">
                    <h2 class="hrd-block__h">Vanliga frågor om {card.title}</h2>
                    <div class="hrd-sub">
                      {faqs.map((f) => (
                        <div class="hrd-item">
                          <p class="hrd-item__t">{typo(f.q)}</p>
                          <p class="hrd-text">{typo(f.a)}</p>
                        </div>
                      ))}
                    </div>
                    <a class="hrd-faq__all" href="/for-hr/?flik=faq">
                      Alla frågor i FAQ
                      <Icon name="ArrowRight" size={14} />
                    </a>
                  </section>
                </div>
              )}

              <div class="hrd-actions">
                <a class="hr-btn" href={linkedin} target="_blank" rel="noopener noreferrer">
                  <Icon name="Users" size={15} />
                  Fråga mig om kortet
                </a>
                <a class="hrd-actions__icon" href={github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
                  <Icon name="Github" size={18} />
                </a>
              </div>
            </article>

            {showToc && (
              <ArticleToc items={toc} variant="panel" title="I det här kortet" />
            )}
          </div>
        )
      }
    </div>
  </div>

  <script>
    import { initHrGuide } from "../../scripts/hrGuide";
    import { initToc } from "../../scripts/toc";
    initHrGuide();
    initToc();
  </script>
</AppLayout>
